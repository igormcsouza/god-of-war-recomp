diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 2bb2271..9f5cbdc 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -683,3 +683,12 @@ endif()
 install(DIRECTORY include/
     DESTINATION include
 )
+
+# GOW-Port include: the generated code includes <ps2_recompiled_functions.h> from src/runner.
+target_include_directories(ps2EntryRunner PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src/runner)
+
+# GOW-Port: PS2X_RUNNER_O1=ON compiles the (huge) generated runner at -O1 for practical build times (Linux helper).
+option(PS2X_RUNNER_O1 "Compile ps2EntryRunner at -O1 in Release (GCC/Clang)" OFF)
+if(PS2X_RUNNER_O1 AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+    target_compile_options(ps2EntryRunner PRIVATE $<$<CONFIG:Release>:-O1>)
+endif()
