+        // GOW-Port: God of War reutiliza el mismo bloque libmpeg para cada pelicula y sceMpegGetPicture pone a 1 la palabra
+        // que lee su sceMpegIsEnd al terminar el flujo. Sin sceMpegReset entre peliculas, la tercera empezaba "terminada" y
+        // el juego la abortaba en su estado 6 ("unexpected MPEG error???"): sceMpegCreate debe dejarla a 0.
+        tc.Run("sceMpegCreate clears the end-of-stream word left by the previous movie", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            ps2_stubs::resetMpegStubState();
+            constexpr uint32_t kMpegAddr = 0x00123000u;
+            constexpr uint32_t kBuffer = 0x00130000u;
+            R5900Context createCtx{};
+            setRegU32(createCtx, 4, kMpegAddr);
+            setRegU32(createCtx, 5, kBuffer);
+            setRegU32(createCtx, 6, 0x2000u);
+            ps2_stubs::sceMpegCreate(rdram.data(), &createCtx, &runtime);
+            // Fin del primer flujo: sceMpegGetPicture marca el fin en *(*(mpeg + 0x40)).
+            ps2_stubs::notifyMpegCdStreamStart();
+            ps2_stubs::notifyMpegCdStreamEof();
+            R5900Context pictureCtx{};
+            setRegU32(pictureCtx, 4, kMpegAddr);
+            setRegU32(pictureCtx, 5, 0x00140000u);
+            ps2_stubs::sceMpegGetPicture(rdram.data(), &pictureCtx, &runtime);
+            const uint32_t inner = Ps2FastRead32(rdram.data(), kMpegAddr + 0x40u);
+            t.Equals(Ps2FastRead32(rdram.data(), inner), 1u, "the first movie ends with the end word set");
+
+            ps2_stubs::resetMpegStubState();
+            ps2_stubs::sceMpegCreate(rdram.data(), &createCtx, &runtime);
+            t.Equals(Ps2FastRead32(rdram.data(), Ps2FastRead32(rdram.data(), kMpegAddr + 0x40u)), 0u,
+                     "a new sceMpegCreate must not inherit the end word of the previous movie");
+            runtime.requestStop();
+        });
