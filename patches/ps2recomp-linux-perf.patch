+    // Texture pages (8 KB) read by the draw vs. frame/Z pages written by it. Over-estimates both ranges.
+    bool gowTextureAliasesTargets(const GSDrawState &state, int maxY)
+    {
+        if (!state.prim.tme)
+            return false;
+        const auto &ctx = state.context;
+        std::array<bool, 512> target{};
+        const uint32_t rows = static_cast<uint32_t>(std::max(maxY, 0) + 1 + 31) / 32u;
+        const uint32_t pagesPerBuffer = std::max<uint32_t>(ctx.frame.fbw, 1u) * rows;
+        for (const uint32_t base : {GSInternal::framePageBaseToBlock(ctx.frame.fbp) >> 5, GSInternal::framePageBaseToBlock(ctx.zbuf.zbp) >> 5})
