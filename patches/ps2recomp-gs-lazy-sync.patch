+
+// GOW-Port: lazy host sync + two-phase Present. Every host access to VRAM in this backend (GOW_VK_CPU, transfers,
+// CLUT loads, CPU fallbacks) still ends the GPU run; only the frontend's Flush/Sync(Finish|Presentation) and the
+// Present wait are skipped. PS2X_VK_LAZY_SYNC=0 restores them; PS2X_VK_SYNC_PRESENT=1 keeps only the old Present.
+static bool envOn(const char *name, bool otherwise)
+{
+    const char *v = std::getenv(name);
+    return v && *v ? *v != '0' : otherwise;
+}
+bool GSVulkanBackend::LazyHostSync() const
+{
+    static const bool on = envOn("PS2X_VK_LAZY_SYNC", true);
+    return on && m_impl != nullptr;
+}
+
+struct GSVulkanBackend::PendingFrame : GSRasterBackend::PendingPresent
+{
+    std::shared_ptr<PresentRing> ring;
+    uint32_t slot;
+    GSPresentationRequest request;
+    bool resolved = false;
+    PendingFrame(std::shared_ptr<PresentRing> r, uint32_t i, const GSPresentationRequest &q) : ring(std::move(r)), slot(i), request(q) {}
+    ~PendingFrame() override
+    {
+        if (!resolved)
+            ring->state[slot].store(2, std::memory_order_release);
+    }
+    PresentationFrame Resolve() override
+    {
+        PresentRing &r = *ring;
+        vkWaitForFences(r.s.device, 1, &r.fence[slot], VK_TRUE, UINT64_MAX);
+        // Same composition as GSCpuBackend::Present, on the staged copy instead of a host snapshot.
+        thread_local GSCpuBackend composer;
+        composer.Initialize(static_cast<uint8_t *>(r.map[slot]), GSSwizzle::kMemorySize);
+        PresentationFrame frame = composer.PresentFromLocalMemory(request);
+        vkResetFences(r.s.device, 1, &r.fence[slot]);
+        r.state[slot].store(0, std::memory_order_release);
+        resolved = true;
+        return frame;
+    }
+};
+
+std::unique_ptr<GSRasterBackend::PendingPresent> GSVulkanBackend::BeginPresent(const GSPresentationRequest &request)
+{
+    static const bool off = envOn("PS2X_VK_SYNC_PRESENT", false);
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    // No GPU run in flight: host VRAM is current, the plain Present is already cheap.
+    if (off || !m_impl || !m_impl->open || m_impl->cmdIndex + 1 >= kMaxCmds)
+        return nullptr;
+    Impl &impl = *m_impl;
+    if (!impl.ring)
+    {
+        impl.ring = std::make_shared<PresentRing>(impl.s);
+        if (!impl.ring->ok)
+            std::fprintf(stderr, "[gow-gs] Vulkan present staging unavailable; Present stays synchronous\n");
+    }
+    if (!impl.ring->ok)
+        return nullptr;
+    const int slot = impl.ring->acquire();
+    if (slot < 0)
+        return nullptr;
+    impl.emitBatch();
+    // shader writes -> copy; copy -> host read, and copy (reads VRAM) -> the next shader writes (WAR).
+    impl.memoryBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    const VkBuffer src = impl.imported ? impl.importedVram : impl.vram;
+    const VkBufferCopy region{0, 0, GSSwizzle::kMemorySize};
+    vkCmdCopyBuffer(impl.cmd, src, impl.ring->buf[slot], 1, &region);
+    VkMemoryBarrier after{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    after.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    after.dstAccessMask = VK_ACCESS_HOST_READ_BIT | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    vkCmdPipelineBarrier(impl.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1,
+                         &after, 0, nullptr, 0, nullptr);
+    impl.submitCmd();
+    impl.cmd = impl.cmds[++impl.cmdIndex];
+    impl.beginCmd();
+    impl.primsAtSubmit = impl.primCount;
+    {
+        // An empty batch with the slot fence: a fence signals after everything submitted before it on this queue.
+        VkSubmitInfo empty{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        std::lock_guard<std::mutex> queueLock(impl.s.queueMutex);
+        vkQueueSubmit(impl.s.queue, 1, &empty, impl.ring->fence[slot]);
+    }
+    impl.ring->state[slot].store(1, std::memory_order_release);
+    ++impl.statsAsyncPresent;
+    return std::make_unique<PendingFrame>(impl.ring, static_cast<uint32_t>(slot), request);
+}
