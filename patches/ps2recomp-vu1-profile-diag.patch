+// GOW-Port: GOW_VU1_SAMPLE=1 -- tiny in-process RIP sampler for the VU1 worker thread (perf is not usable when
+// perf_event_paranoid > 2). SIGPROF from a per-thread CPU-time timer every 100 us records the interrupted RIP; every 10 s
+// the histogram is printed as "[vu1-sample] <offset in image> <count>" for objdump/addr2line.
+std::atomic<uint32_t> g_sampleN{0};
+uint64_t g_sampleRip[1u << 20];
+void vu1SampleHandler(int, siginfo_t *, void *uc)
+{
+    const uint32_t i = g_sampleN.fetch_add(1, std::memory_order_relaxed);
+    if (i < (1u << 20))
+        g_sampleRip[i] = static_cast<uint64_t>(static_cast<ucontext_t *>(uc)->uc_mcontext.gregs[REG_RIP]);
+}
+void vu1SampleEnsure()
+{
+    static const bool wanted = [] { const char *v = std::getenv("GOW_VU1_SAMPLE"); return v && *v && *v != '0'; }();
+    thread_local bool done = false;
+    if (!wanted || done)
+        return;
+    done = true;
+    struct sigaction sa {};
+    sa.sa_sigaction = vu1SampleHandler;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigaction(SIGPROF, &sa, nullptr);
+    sigevent ev {};
+    ev.sigev_notify = SIGEV_THREAD_ID;
+    ev.sigev_signo = SIGPROF;
+    ev._sigev_un._tid = static_cast<int>(syscall(SYS_gettid));
+    timer_t timer;
+    clockid_t clk;
+    pthread_getcpuclockid(pthread_self(), &clk);
+    if (timer_create(clk, &ev, &timer) != 0)
+        return;
+    itimerspec its {};
+    its.it_interval.tv_nsec = 100000;
+    its.it_value.tv_nsec = 100000;
+    timer_settime(timer, 0, &its, nullptr);
+    std::thread([] {
+        Dl_info info {};
+        dladdr(reinterpret_cast<void *>(&vu1SampleEnsure), &info);
+        const uint64_t base = reinterpret_cast<uint64_t>(info.dli_fbase);
+        for (;;)
+        {
+            std::this_thread::sleep_for(std::chrono::seconds(10));
+            const uint32_t n = std::min<uint32_t>(g_sampleN.exchange(0), 1u << 20);
+            std::map<uint64_t, uint32_t> hist;
+            for (uint32_t k = 0; k < n; ++k)
+                ++hist[g_sampleRip[k] - base];
+            std::fprintf(stderr, "[vu1-sample] total=%u\n", n);
+            for (const auto &[a, c] : hist)
+                std::fprintf(stderr, "[vu1-sample] %llx %u\n", static_cast<unsigned long long>(a), c);
+        }
+    }).detach();
+}
+} // namespace
+#else
+namespace
+{
+void vu1SampleEnsure() {}
+} // namespace
+#endif
