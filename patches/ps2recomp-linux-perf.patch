+// GOW-Port: row-parallel CPU rasterization must give the same VRAM as the serial path (no game needed).
+#include "MiniTest.h"
+#include "runtime/gs/gs_cpu_backend.h"
+#include <vector>
+namespace {
+std::vector<uint8_t> render(int threads, bool feedback) {
+    std::vector<uint8_t> vram(4u << 20);
+    uint32_t seed = 12345u;
+    for (auto &b : vram) { seed = seed * 1664525u + 1013904223u; b = uint8_t(seed >> 24); }
+    GSCpuSetRasterThreads(threads);
+    GSCpuBackend backend;
+    backend.Initialize(vram.data(), uint32_t(vram.size()));
+    const uint32_t texBase = feedback ? 100u * 32u : 0u; // feedback: texture inside the frame pages
+    for (uint32_t y = 0; y < 64; ++y)
+        for (uint32_t x = 0; x < 64; ++x)
+            backend.WriteVram(GS_PSM_CT32, texBase, 1, x, y, 0x80000000u | (x * 4u) | (y * 4u << 8) | ((x ^ y) << 16));
+    auto state = [&](GSPrimitiveBatch &b, GSPrimType type, bool tex) {
+        b.vertexCount = type == GS_PRIM_SPRITE ? 2 : 3;
+        b.state.prim.type = type; b.state.prim.tme = tex; b.state.prim.fst = true; b.state.prim.iip = true;
+        b.state.prim.abe = true;
+        b.state.textureWidth = b.state.textureHeight = 64;
+        auto &c = b.state.context;
+        c.frame = {100, 10, GS_PSM_CT32, 0}; c.scissor = {0, 639, 0, 447};
+        c.zbuf = {200, GS_PSM_Z32, true}; c.test = 0;
+        c.alpha = (uint64_t(128) << 32) | 0x44u; // Cs*As + Cd*(1-As)... any fixed blend is fine
+        c.tex0.tbp0 = texBase; c.tex0.tbw = 1; c.tex0.psm = GS_PSM_CT32; c.tex0.tw = 6; c.tex0.th = 6; c.tex0.tcc = 1;
+    };
+    GSPrimitiveBatch sprite{}; state(sprite, GS_PRIM_SPRITE, true);
+    float sx[2] = {20.5f, 520.5f}, sy[2] = {10.5f, 300.5f};
+    for (unsigned i = 0; i < 2; ++i) { auto &v = sprite.vertices[i]; v.x = sx[i]; v.y = sy[i]; v.z = 7; v.u = uint16_t(i * 64u * 16u); v.v = uint16_t(i * 64u * 16u); v.r = v.g = v.b = 0x80; v.a = 0x70; }
+    backend.Submit(sprite);
+    GSPrimitiveBatch tri{}; state(tri, GS_PRIM_TRIANGLE, true);
+    float tx[3] = {30.0f, 600.0f, 100.0f}, ty[3] = {40.0f, 90.0f, 420.0f};
+    for (unsigned i = 0; i < 3; ++i) { auto &v = tri.vertices[i]; v.x = tx[i]; v.y = ty[i]; v.z = 9; v.u = uint16_t(i * 500u); v.v = uint16_t(i * 300u); v.r = uint8_t(60 + i * 70); v.g = uint8_t(200 - i * 60); v.b = uint8_t(10 + i * 90); v.a = 0x60; }
+    backend.Submit(tri);
+    GSPrimitiveBatch flat{}; state(flat, GS_PRIM_SPRITE, false);
+    for (unsigned i = 0; i < 2; ++i) { auto &v = flat.vertices[i]; v.x = 50.0f + i * 300.0f; v.y = 200.0f + i * 150.0f; v.z = 3; v.r = 200; v.g = 30; v.b = 90; v.a = 0x50; }
+    backend.Submit(flat);
+    backend.Flush();
+    GSCpuSetRasterThreads(1);
+    return vram;
+}
+}
+void register_gs_cpu_parallel_tests() {
+    MiniTest::Case("GS CPU parallel raster", [](TestCase &test) {
+        test.Run("Parallel rows equal serial rows", [](TestCase &t) {
+            const auto serial = render(1, false);
+            const auto parallel = render(4, false);
+            t.IsTrue(serial == parallel, "Textured sprite, triangle and flat sprite give identical VRAM");
+            std::vector<uint8_t> blank(4u << 20);
+            uint32_t seed = 12345u;
+            for (auto &b : blank) { seed = seed * 1664525u + 1013904223u; b = uint8_t(seed >> 24); }
+            t.IsTrue(serial != blank, "The draws changed VRAM");
+        });
+        test.Run("Texture feedback stays serial", [](TestCase &t) {
+            t.IsTrue(render(1, true) == render(4, true), "Feedback draw is identical with and without workers");
+        });
+    });
+}
