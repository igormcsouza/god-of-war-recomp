diff --git a/ps2xIOP/src/emulator/core/spu2.cpp b/ps2xIOP/src/emulator/core/spu2.cpp
index 5883746..fbe7a21 100644
--- a/ps2xIOP/src/emulator/core/spu2.cpp
+++ b/ps2xIOP/src/emulator/core/spu2.cpp
@@ -255,7 +255,6 @@ namespace ps2x::iop::detail
         if ((v.blockFlags & 1u) != 0u)
         {
             m_endx[core] |= 1u << index;
-            v.nax = v.lsa;
             if ((v.blockFlags & 2u) == 0u)
             {
                 v.active = false;
@@ -293,7 +292,12 @@ namespace ps2x::iop::detail
         }
         checkIrqAddress(block);
         v.decodedIndex = 0;
-        v.nax = (block + 8u) & (RamHalfwords - 1u);
+        // GOW-Port: con la marca de fin la direccion siguiente es LSA desde que se lee ese bloque, no cuando acaba
+        // de sonar: el hardware nunca muestra NAX justo detras del buffer. 989snd comprueba que NAX caiga dentro
+        // de su buffer de streaming y, con NAX justo detras de el, abandonaba la corriente (la musica se cortaba y
+        // reiniciaba cada 0,36 s cuando su sondeo de 4 ms coincidia con el ultimo bloque). LSA queda fijado aqui:
+        // lo que el driver escriba despues vale para el siguiente final de bucle.
+        v.nax = (v.blockFlags & 1u) != 0u ? v.lsa & (RamHalfwords - 1u) : (block + 8u) & (RamHalfwords - 1u);
     }
 
