-    struct Entry
-    {
-        const uint32_t *words;
-        uint64_t generation;
-        bool matches;
-    };
-    static Entry cache[2048];
-    Entry &entry = cache[(reinterpret_cast<uintptr_t>(words) >> 3) & 2047u];
-    if (entry.words == words && entry.generation == m_compiledGeneration)
-        return entry.matches;
+    // empezar cada ejecución); cada bloque guarda su propio resultado de comparar (antes, una tabla con hash
+    // compartida por todos los bloques).
+    if (check.generation == m_compiledGeneration)
+        return check.matches;
     const bool matches = std::memcmp(context.vuCode + pc, words, bytes) == 0;
-    entry = {words, m_compiledGeneration, matches};
+    check = {m_compiledGeneration, matches};
     return matches;
 }
 
