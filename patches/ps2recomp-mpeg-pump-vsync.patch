+    // GOW-Port: God of War's movie pump calls sceMpegDemuxPssRing ~800,000 times per second while the decoded picture
+    // queue is full; returning at once kept the EE at 100% host CPU and the emulated clock ran slower than real time.
+    constexpr uint32_t kPumpMainPc = 0x00125400u;
+    constexpr uint32_t kPumpResumePc = 0x00125410u;
+    constexpr uint32_t kPumpVsyncPc = 0x00125420u;
+    constexpr uint32_t kPumpHandle = 0x00124A00u;
+    std::atomic<uint32_t> gPumpVsyncRan{0u};
+    std::atomic<uint32_t> gPumpVsyncSeenAtReturn{99u};
+    std::atomic<int32_t> gPumpResult{-999};
+
+    void testPumpMain(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 4, kPumpHandle);
+        setRegU32(*ctx, 5, 0x00134000u);
+        setRegU32(*ctx, 6, 0x100u);
+        setRegU32(*ctx, 7, 0u);
+        setRegU32(*ctx, 8, 0xFFFFFFFFu);
+        ctx->pc = kPumpResumePc;
+        ps2_stubs::sceMpegDemuxPssRing(rdram, ctx, runtime);
+    }
+
+    void testPumpResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        gPumpVsyncSeenAtReturn.store(gPumpVsyncRan.load(std::memory_order_acquire), std::memory_order_release);
+        gPumpResult.store(getRegS32(*ctx, 2), std::memory_order_release);
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void testPumpVsync(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        gPumpVsyncRan.store(1u, std::memory_order_release);
+        runtime->eeScheduler().completeVSync(runtime->eeScheduler().currentVSyncTick() + 1u);
+        ctx->pc = 0u;
+    }
+
