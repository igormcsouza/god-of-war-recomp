+    // GOW-Port: load SDL_GameControllerDB mappings once the window (GLFW) is up. Sources, in order:
+    // $GOW_PAD_MAPPINGS (file), $SDL_GAMECONTROLLERCONFIG, then well-known db paths.
+    void loadPadMappings()
+    {
+        static bool done = false;
+        if (done || !IsWindowReady())
+            return;
+        done = true;
+        std::vector<std::string> paths;
+        const char *e = std::getenv("GOW_PAD_MAPPINGS");
+        if (e && *e)
+            paths.push_back(e);
+        const char *xdg = std::getenv("XDG_CONFIG_HOME");
+        const char *home = std::getenv("HOME");
+        if (xdg && *xdg)
+            paths.push_back(std::string(xdg) + "/gow-one/gamecontrollerdb.txt");
+        else if (home)
+            paths.push_back(std::string(home) + "/.config/gow-one/gamecontrollerdb.txt");
+        paths.push_back("/usr/share/sdl-gamecontrollerdb/gamecontrollerdb.txt");
+        paths.push_back("/usr/share/SDL_GameControllerDB/gamecontrollerdb.txt");
+        paths.push_back("/usr/share/games/SDL_GameControllerDB/gamecontrollerdb.txt");
+        if (home)
+        {
+            paths.push_back(std::string(home) + "/.local/share/lutris/runtime/gamecontrollerdb/gamecontrollerdb.txt");
+            paths.push_back(std::string(home) + "/.steam/steam/controller_base/gamecontrollerdb.txt");
+        }
+        for (const auto &p : paths)
+        {
+            const std::string m = ps2PadLinuxMappings(readTextFile(p));
+            if (!m.empty() && glfwUpdateGamepadMappings(m.c_str()))
+                std::fprintf(stderr, "[gow-pad] loaded gamepad mappings from %s\n", p.c_str());
+        }
+        const char *env = std::getenv("SDL_GAMECONTROLLERCONFIG");
+        if (env && *env)
+            glfwUpdateGamepadMappings(env);
+    }
+
+    // GOW-Port: a connected pad without any mapping reads as zeros; give it a generic one.
+    void mapUnknownPads()
+    {
+        static std::string tried[4];
+        for (int i = 0; i < 4; ++i)
+        {
+            if (!IsGamepadAvailable(i) || glfwJoystickIsGamepad(i))
+                continue;
+            const char *g = glfwGetJoystickGUID(i);
+            if (!g || tried[i] == g)
+                continue;
+            tried[i] = g;
+            const char *n = GetGamepadName(i);
+            const std::string m = ps2PadGenericMapping(g, n ? n : "");
+            glfwUpdateGamepadMappings(m.c_str());
+            std::fprintf(stderr, "[gow-pad] pad %d '%s' guid=%s has no SDL mapping, using generic Xbox-like layout "
+                                 "(set GOW_PAD_MAPPINGS=<gamecontrollerdb.txt> to fix)\n",
+                         i, n ? n : "", g);
+        }
+    }
+
+    // GOW-Port: GOW_PAD_DIAG=1: once a second, what GLFW sees for each pad (raw axes/buttons).
+    void padDiag()
+    {
+        static const bool on = std::getenv("GOW_PAD_DIAG") != nullptr;
+        static auto last = std::chrono::steady_clock::time_point{};
+        const auto now = std::chrono::steady_clock::now();
+        if (!on || now - last < std::chrono::seconds(1))
+            return;
+        last = now;
+        std::string line;
+        for (int i = 0; i < 4; ++i)
+        {
+            if (!IsGamepadAvailable(i))
+                continue;
+            int na = 0, nb = 0;
+            const float *a = glfwGetJoystickAxes(i, &na);
+            const unsigned char *b = glfwGetJoystickButtons(i, &nb);
+            char buf[96];
+            std::snprintf(buf, sizeof buf, "[gow-pad] #%d '%s' guid=%s gamepad=%d axes=",
+                          i, GetGamepadName(i) ? GetGamepadName(i) : "", glfwGetJoystickGUID(i), glfwJoystickIsGamepad(i));
+            line = buf;
+            for (int k = 0; a && k < na; ++k)
+                line += std::to_string(a[k]).substr(0, 5) + " ";
+            line += "buttons=";
+            for (int k = 0; b && k < nb; ++k)
+                line += b[k] ? '1' : '0';
+            std::fprintf(stderr, "%s\n", line.c_str());
+        }
+        if (line.empty())
+            std::fprintf(stderr, "[gow-pad] no joystick visible to GLFW (check /dev/input permissions: group 'input')\n");
+    }
+}
