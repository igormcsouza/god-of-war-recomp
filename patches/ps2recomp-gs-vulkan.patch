+// GOW-Port: build-time tool for the Vulkan GS backend. Writes the GLSL of the Vulkan raster kernel to
+// a file: the VRAM addressing helpers come from the OpenGL backend (GSGpuShaders::kCommon) so both GPU
+// backends share one swizzle implementation. Usage: gs_vulkan_shader_export <out.comp>; CMake then
+// compiles the file to SPIR-V with glslangValidator.
+#include "gs_gpu_shaders.h"
+
+#include <cstdio>
+
+namespace
+{
+    // Offsets of each page table inside the swizzle buffer; same order and sizes as gs_gpu_backend.cpp
+    // and initShared() in gs_vulkan_backend.cpp.
+    const char *const kPrefix = R"GLSL(#version 460
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+#define TABLE_C32 0u
+#define TABLE_Z32 65536u
+#define TABLE_C16 131072u
+#define TABLE_C16S 262144u
+#define TABLE_Z16 393216u
+#define TABLE_Z16S 524288u
+#define TABLE_P8 655360u
+#define TABLE_P4 917504u
+)GLSL";
+
+    // One batch of primitives per dispatch over their union bounding box. Coverage, Gouraud weights and texture
+    // sampling follow GSCpuBackend::DrawSprite/DrawTriangle/SampleTexture exactly (gs_triangle_rules.h);
+    // the pixel write follows GSCpuBackend::WritePixel for the subset GSVulkanBackend accepts (no fog,
+    // blend, tests or Z). Float math is `precise` (no FMA contraction, like -march=x86-64-v2 on the CPU)
+    // and 1/Q uses an exact integer division because GLSL division is not correctly rounded.
+    const char *const kKernel = R"GLSL(
+layout(local_size_x = 8, local_size_y = 8) in;
+
+// Must match PrimRecord in gs_vulkan_backend.cpp.
+struct Prim
+{
+    int64_t ea[3];
+    int64_t eb[3];
+    int64_t ec[3];
+    int64_t area;
+    int rect[4];     // inclusive x0, y0, x1, y1
+    uint frame;      // frame base in blocks | fbw << 16
+    uint mode;       // psm | M_* flags
+    uint fbmsk;
+    uint color[3];   // sprite / flat: color[0]; Gouraud: v0, v1, v2
+    uint tex;        // tbp0 | tbw << 16 | tpsm << 24
+    uint tsize;      // texW | texH << 16
+    uint tmode;      // tcc | tfx << 8 | cpsm << 16 | csm << 24
+    uint texa;       // csa | ta0 << 8 | aem << 16 | ta1 << 24
+    uint clampLo;    // CLAMP bits 0..31
+    uint clampHi;    // CLAMP bits 32..63
+    float axis[4];   // sprite: origin/scale of X, then Y
+    float attr[12];  // sprite: u0 v0 u1 v1 (texels); triangle: s t q per vertex, or u v per vertex (FST)
+    uint alpha;      // ALPHA A|B<<2|C<<4|D<<6 | FIX << 8 | M_* blend flags
+    uint test;       // TEST bits 0..13 (ATE, ATST, AREF, AFAIL)
+    uint zbuf;       // Z base in blocks | zpsm << 16 | ZTST << 24 (ALWAYS when ZTE=0) | Z write << 26
+    uint z;          // Z of v0 (sprites: v1), an integer
+    int zd[2];       // triangles: integer Z(v1) - Z(v0), Z(v2) - Z(v0), |d| < 2^28
+};
+layout(std430, binding = 3) readonly buffer PrimBuffer { Prim prims[]; };
+// A dispatch covers the union rectangle (origin) of a batch of primitives [first, first + count) that may
+// run in any workgroup order against each other; each pixel is owned by one thread, which applies the
+// batch's primitives in order.
+layout(push_constant) uniform Push { int originX; int originY; uint first; uint count; } pc;
+uint curPrim;
+shared uint hit[32]; // GOW-Port: kMaxBatch (1024) bits
+#define P prims[curPrim]
+
+const uint M_TRIANGLE = 0x100u;
+const uint M_IIP = 0x200u;
+const uint M_FBA = 0x400u;
+const uint M_BIAS0 = 0x800u;
+const uint M_TME = 0x4000u;
+const uint M_FST = 0x8000u;
+const uint M_LINEAR = 0x10000u;
+const uint M_ZIP = 0x20000u;
+const uint A_ABE = 0x10000u;
+const uint A_PABE = 0x20000u;
+const uint A_COLCLAMP = 0x40000u;
+
+bool passesAlphaTest(uint test, uint a)
+{
+    uint aref = (test >> 4u) & 0xFFu;
+    switch ((test >> 1u) & 7u)
+    {
+    case 0u: return false;
+    case 1u: return true;
+    case 2u: return a < aref;
+    case 3u: return a <= aref;
+    case 4u: return a == aref;
+    case 5u: return a >= aref;
+    case 6u: return a > aref;
+    }
+    return a != aref;
+}
+
+int pickRgb(uint sel, int cs, int cd)
+{
+    return sel == 0u ? cs : (sel == 1u ? cd : 0);
+}
+
+// Alpha blending of GSCpuBackend::WritePixel; dst is the frame pixel as RGBA8888.
+uint blend(uint src, uint dst)
+{
+    uint alpha = P.alpha;
+    uint a = src >> 24u;
+    if ((alpha & A_PABE) != 0u && (a & 0x80u) == 0u)
+        return src;
+    uint csel = (alpha >> 4u) & 3u;
+    int cAlpha = csel == 0u ? int(a) : (csel == 1u ? int(dst >> 24u) : int((alpha >> 8u) & 0xFFu));
+    uint out_ = src & 0xFF000000u;
+    for (uint shift = 0u; shift < 24u; shift += 8u)
+    {
+        int cs = int((src >> shift) & 0xFFu);
+        int cd = int((dst >> shift) & 0xFFu);
+        int value = ((pickRgb(alpha & 3u, cs, cd) - pickRgb((alpha >> 2u) & 3u, cs, cd)) * cAlpha >> 7) +
+                    pickRgb((alpha >> 6u) & 3u, cs, cd);
+        out_ |= ((alpha & A_COLCLAMP) != 0u ? clampU8(value) : (uint(value) & 0xFFu)) << shift;
+    }
+    return out_;
+}
+
+// Correctly rounded float(n / d) = q * 2^-shift for 0 < n < d, as float(double(n) * (1.0 / d)) on the CPU.
+int64_t ratioMantissa(int64_t n, int64_t d, out int shift)
+{
+    int s = 0;
+    while ((n << s) < d)
+        ++s;
+    int64_t num = n << (s + 23);
+    int64_t q = num / d;
+    int64_t r = num - q * d;
+    if (2l * r > d || (2l * r == d && (q & 1l) != 0l))
+        ++q;
+    shift = s + 23;
+    return q;
+}
+
+float ratio(int64_t n, int64_t d)
+{
+    if (n <= 0l)
+        return 0.0;
+    if (n >= d)
+        return 1.0;
+    int shift;
+    float q = float(ratioMantissa(n, d, shift));
+    return ldexp(q, -shift);
+}
+
+// dz * ratio(n, d) in 2^-34 fixed point (exact unless the weight has more than 34 fraction bits).
+int64_t zTerm(int64_t dz, int64_t n, int64_t d)
+{
+    if (n <= 0l)
+        return 0l;
+    if (n >= d)
+        return dz << 34;
+    int shift;
+    int64_t p = dz * ratioMantissa(n, d, shift);
+    if (shift <= 34)
+        return p << (34 - shift);
+    return (p + (1l << (shift - 35))) >> (shift - 34);
+}
+
+// Correctly rounded 1.0f / d for a normal d (fabsQ keeps |d| > 1e-8), like divss on the CPU.
+float recipExact(float d)
+{
+    uint bits = floatBitsToUint(d);
+    uint ex = (bits >> 23u) & 0xFFu;
+    if (ex == 0xFFu)
+        return (bits & 0x7FFFFFu) != 0u ? d : uintBitsToFloat(bits & 0x80000000u);
+    if (ex == 0u)
+        return 1.0 / d;
+    int64_t m = int64_t((bits & 0x7FFFFFu) | 0x800000u);
+    int64_t q = (1l << 47) / m;
+    if (2l * ((1l << 47) - q * m) > m)
+        ++q;
+    float result = ldexp(float(q), 103 - int(ex));
+    return (bits & 0x80000000u) != 0u ? -result : result;
+}
+
+uint channel(uint c0, uint c1, uint c2, uint shift, float w1, float w2)
+{
+    int a = int((c0 >> shift) & 0xFFu);
+    int b = int((c1 >> shift) & 0xFFu);
+    int c = int((c2 >> shift) & 0xFFu);
+    precise float v = float(a) + float(b - a) * w1;
+    precise float result = v + float(c - a) * w2;
+    return clampU8(int(result)) << shift;
+}
+
+uint applyTexa(uint psm, uint texel)
+{
+    if (psm == 0u)
+        return texel;
+    uint ta0 = (P.texa >> 8u) & 0xFFu;
+    bool aem = ((P.texa >> 16u) & 1u) != 0u;
+    uint ta1 = P.texa >> 24u;
+    bool rgbZero = (texel & 0x00FFFFFFu) == 0u;
+    uint a = texel >> 24u;
+    if (psm == 1u || psm == 0x31u)
+        a = (aem && rgbZero) ? 0u : ta0;
+    else if (psm == 2u || psm == 10u || psm == 0x32u || psm == 0x3Au)
+        a = (a & 0x80u) != 0u ? ta1 : ((aem && rgbZero) ? 0u : ta0);
+    return (texel & 0x00FFFFFFu) | (a << 24u);
+}
+
+int wrapCoordinate(int coordinate, int size, uint mode, uint regionMin, uint regionMax)
+{
+    switch (mode & 3u)
+    {
+    case 0u: return int(uint(coordinate) & uint(size - 1));
+    case 1u: return clamp(coordinate, 0, size - 1);
+    case 2u: return min(max(coordinate, int(regionMin)), int(regionMax));
+    }
+    return int((uint(coordinate) & regionMin) | regionMax);
+}
+
+bool isFourBit(uint psm) { return psm == 0x14u || psm == 0x24u || psm == 0x2Cu; }
+bool isEightBit(uint psm) { return psm == 0x13u || psm == 0x1Bu; }
+
+// GSCpuBackend::LookupCLUT; the CLUT buffer holds GSCpuBackend::m_clut as uploaded at the start of the run.
+uint lookupClut(uint index)
+{
+    uint cpsm = (P.tmode >> 16u) & 0xFFu;
+    uint csm = (P.tmode >> 24u) & 1u;
+    uint clutVer = P.tmode >> 25u;
+    uint sourcePsm = P.tex >> 24u;
+    bool sixteenBit = cpsm == 2u || cpsm == 10u;
+    uint clutBase = (P.texa & (sixteenBit ? 0x1Fu : 0x0Fu)) << 4u;
+    uint sourceIndex = isFourBit(sourcePsm) ? (index & 0x0Fu) : index;
+    uint clutIndex = (clutBase + sourceIndex) & (sixteenBit ? 0x1FFu : 0x0FFu);
+    if (!sixteenBit && csm == 0u && isEightBit(sourcePsm))
+        clutIndex = min((sourceIndex & 0xF0u) + clutBase, 240u) + (sourceIndex & 0x0Fu);
+    if (cpsm == 0u || cpsm == 1u)
+    {
+        uint raw = clutEntry(clutVer, clutIndex) | (clutEntry(clutVer, clutIndex + 256u) << 16u);
+        return applyTexa(cpsm, cpsm == 1u ? raw & 0x00FFFFFFu : raw);
+    }
+    if (sixteenBit)
+        return applyTexa(cpsm, rgba5551To8888(clutEntry(clutVer, clutIndex)));
+    return 0xFFFF00FFu;
+}
+
+uint samplePoint(int u, int v)
+{
+    uint lo = P.clampLo;
+    uint hi = P.clampHi;
+    u = wrapCoordinate(u, int(P.tsize & 0xFFFFu), lo & 3u, (lo >> 4u) & 0x3FFu, (lo >> 14u) & 0x3FFu);
+    v = wrapCoordinate(v, int(P.tsize >> 16u), (lo >> 2u) & 3u, (lo >> 24u) | ((hi & 3u) << 8u), (hi >> 2u) & 0x3FFu);
+    uint psm = P.tex >> 24u;
+    uint raw = readPixel(psm, P.tex & 0x3FFFu, (P.tex >> 16u) & 0xFFu, uint(u), uint(v));
+    switch (psm)
+    {
+    case 0x00u: case 0x30u: case 0x01u: case 0x31u:
+        return applyTexa(psm, raw);
+    case 0x02u: case 0x0Au: case 0x32u: case 0x3Au:
+        return applyTexa(psm, rgba5551To8888(raw));
+    case 0x13u: case 0x1Bu: case 0x14u: case 0x24u: case 0x2Cu:
+        return lookupClut(raw & 0xFFu);
+    }
+    return 0xFFFF00FFu;
+}
+
+uint lerpChannel(uint c00, uint c10, uint c01, uint c11, float fx, float fy)
+{
+    uint wx = min(uint(fx * 16.0), 15u);
+    uint wy = min(uint(fy * 16.0), 15u);
+    uint top = ((16u - wx) * c00 + wx * c10) >> 4u;
+    uint bottom = ((16u - wx) * c01 + wx * c11) >> 4u;
+    return ((16u - wy) * top + wy * bottom) >> 4u;
+}
+
+// GSCpuBackend::SampleTexture after the S/Q, T/Q scaling: texel coordinates in, RGBA8888 out.
+uint sampleTexture(float texUf, float texVf)
+{
+    const float inv = 1.0 / 65536.0; // exact; GLSL x / 65536.0 need not be
+    precise float fixedU = trunc(texUf * 65536.0);
+    precise float fixedV = trunc(texVf * 65536.0);
+    if ((P.mode & M_LINEAR) == 0u)
+        return samplePoint(int(floor(fixedU * inv)), int(floor(fixedV * inv)));
+    precise float sampleU = fixedU * inv - 0.5;
+    precise float sampleV = fixedV * inv - 0.5;
+    int u0 = int(floor(sampleU));
+    int v0 = int(floor(sampleV));
+    precise float fx = sampleU - float(u0);
+    precise float fy = sampleV - float(v0);
+    uint c00 = samplePoint(u0, v0);
+    uint c10 = samplePoint(u0 + 1, v0);
+    uint c01 = samplePoint(u0, v0 + 1);
+    uint c11 = samplePoint(u0 + 1, v0 + 1);
+    uint result = 0u;
+    for (uint shift = 0u; shift < 32u; shift += 8u)
+        result |= lerpChannel((c00 >> shift) & 0xFFu, (c10 >> shift) & 0xFFu, (c01 >> shift) & 0xFFu,
+                              (c11 >> shift) & 0xFFu, fx, fy) << shift;
+    return result;
+}
+
+// combineTexture of gs_cpu_backend.cpp (TCC/TFX).
+uint combineTexture(uint shade, uint texel)
+{
+    bool tcc = (P.tmode & 0xFFu) != 0u;
+    uint tfx = (P.tmode >> 8u) & 0xFFu;
+    int va = int(shade >> 24u);
+    int ta = int(texel >> 24u);
+    if (tfx == 0u || tfx == 2u || tfx == 3u)
+    {
+        int add = tfx == 0u ? 0 : va;
+        uint rgb = 0u;
+        for (uint shift = 0u; shift < 24u; shift += 8u)
+            rgb |= clampU8(((int((texel >> shift) & 0xFFu) * int((shade >> shift) & 0xFFu)) >> 7) + add) << shift;
+        uint a = !tcc ? uint(va) : (tfx == 0u ? clampU8((ta * va) >> 7) : (tfx == 2u ? clampU8(ta + va) : uint(ta)));
+        return rgb | (a << 24u);
+    }
+    return (texel & 0x00FFFFFFu) | ((tcc ? uint(ta) : uint(va)) << 24u);
+}
+
+float fabsQ(float q)
+{
+    return abs(q) > 1.0e-8 ? q : 1.0;
+}
+
+void shade(ivec2 xy)
+{
+    uint mode = P.mode;
+    uint pixel = P.color[0];
+    uint z = P.z;
+    float w1 = 0.0;
+    float w2 = 0.0;
+    if ((mode & M_TRIANGLE) != 0u)
+    {
+        int64_t e[3];
+        for (int i = 0; i < 3; ++i)
+        {
+            e[i] = P.ea[i] * int64_t(xy.x * 16) + P.eb[i] * int64_t(xy.y * 16) + P.ec[i];
+            int64_t bias = (mode & (M_BIAS0 << i)) != 0u ? 1l : 0l;
+            if (e[i] + bias <= 0l)
+                return;
+        }
+        w1 = ratio(e[1], P.area);
+        w2 = ratio(e[2], P.area);
+        // DrawTriangle: u32(z0 + dz1 * w1 + dz2 * w2 + 0.5) in double. Integer Z keeps the fraction exact
+        // here; the CPU's double rounding (2^-21 at Z ~ 2^32) can only differ right at a .5 boundary.
+        // ponytail: fixed point instead of fp64 (missing on Intel Xe); emulate doubles if that ever shows.
+        if ((mode & M_ZIP) != 0u)
+            z += uint((zTerm(int64_t(P.zd[0]), e[1], P.area) + zTerm(int64_t(P.zd[1]), e[2], P.area) + (1l << 33)) >> 34);
+        if ((mode & M_IIP) != 0u)
+        {
+            pixel = 0u;
+            for (uint shift = 0u; shift < 32u; shift += 8u)
+                pixel |= channel(P.color[0], P.color[1], P.color[2], shift, w1, w2);
+        }
+    }
+
+    if ((mode & M_TME) != 0u)
+    {
+        precise float texUf;
+        precise float texVf;
+        if ((mode & M_TRIANGLE) == 0u)
+        {
+            precise float tx = (float(xy.x) - P.axis[0]) * P.axis[1];
+            precise float ty = (float(xy.y) - P.axis[2]) * P.axis[3];
+            texUf = P.attr[0] + (P.attr[2] - P.attr[0]) * tx;
+            texVf = P.attr[1] + (P.attr[3] - P.attr[1]) * ty;
+            if ((mode & M_FST) != 0u)
+            {
+                // UV are re-quantised to 12.4 like DrawSprite; STQ sprites divide by and multiply
+                // by the power-of-two texture size on the CPU, which is exact.
+                precise float fu = texUf * 16.0 + 0.5;
+                precise float fv = texVf * 16.0 + 0.5;
+                texUf = float(clamp(int(fu), 0, 0xFFFF)) * 0.0625;
+                texVf = float(clamp(int(fv), 0, 0xFFFF)) * 0.0625;
+            }
+        }
+        else if ((mode & M_FST) != 0u)
+        {
+            precise float fu = P.attr[0] + (P.attr[2] - P.attr[0]) * w1 + (P.attr[4] - P.attr[0]) * w2;
+            precise float fv = P.attr[1] + (P.attr[3] - P.attr[1]) * w1 + (P.attr[5] - P.attr[1]) * w2;
+            texUf = float(uint(int(fu)) & 0xFFFFu) * 0.0625;
+            texVf = float(uint(int(fv)) & 0xFFFFu) * 0.0625;
+        }
+        else
+        {
+            precise float s = P.attr[0] + (P.attr[3] - P.attr[0]) * w1 + (P.attr[6] - P.attr[0]) * w2;
+            precise float t = P.attr[1] + (P.attr[4] - P.attr[1]) * w1 + (P.attr[7] - P.attr[1]) * w2;
+            precise float q = P.attr[2] + (P.attr[5] - P.attr[2]) * w1 + (P.attr[8] - P.attr[2]) * w2;
+            float invQ = recipExact(fabsQ(q));
+            texUf = s * invQ * float(P.tsize & 0xFFFFu);
+            texVf = t * invQ * float(P.tsize >> 16u);
+        }
+        pixel = combineTexture(pixel, sampleTexture(texUf, texVf));
+    }
+
+    uint psm = mode & 0xFFu;
+    uint fbp = P.frame & 0xFFFFu;
+    uint fbw = P.frame >> 16u;
+    bool is16 = bitsPerPixel(psm) == 16u;
+    // Alpha test (classifyAlphaTest), then the Z test and Z write of GSCpuBackend::WritePixel.
+    bool writeRgb = true;
+    bool writeAlpha = true;
+    bool writeDepth = true;
+    if ((P.test & 1u) != 0u && !passesAlphaTest(P.test, pixel >> 24u))
+    {
+        uint afail = (P.test >> 12u) & 3u;
+        if (afail == 0u)
+            return;
+        writeRgb = afail != 2u;
+        writeAlpha = afail == 1u || (afail == 3u && psm != 0u);
+        writeDepth = afail == 2u;
+    }
+    // Destination alpha test (passesDestinationAlphaTest): CT32 bit 31, CT16/CT16S bit 15; CT24 always passes.
+    if ((P.test & 0x4000u) != 0u && psm != 1u)
+    {
+        uint rawDest = readPixel(psm, fbp, fbw, uint(xy.x), uint(xy.y));
+        bool destAlpha = ((rawDest >> (is16 ? 15u : 31u)) & 1u) != 0u;
+        if (destAlpha != ((P.test & 0x8000u) != 0u))
+            return;
+    }
+    uint zbp = P.zbuf & 0xFFFFu;
+    uint zpsm = (P.zbuf >> 16u) & 0xFFu;
+    uint ztst = (P.zbuf >> 24u) & 3u;
+    if (ztst == 0u)
+        return;
+    if (ztst >= 2u)
+    {
+        uint stored = readPixel(zpsm, zbp, fbw, uint(xy.x), uint(xy.y));
+        if (ztst == 2u ? z < stored : z <= stored)
+            return;
+    }
+
+    bool abe = (P.alpha & A_ABE) != 0u;
+    uint fb = 0u;
+    if (P.fbmsk != 0u || abe || !writeAlpha)
+    {
+        uint raw = readPixel(psm, fbp, fbw, uint(xy.x), uint(xy.y));
+        fb = is16 ? rgba5551To8888(raw) : (psm == 1u ? (raw | 0x80000000u) : raw);
+    }
+    if (abe)
+        pixel = blend(pixel, fb);
+    if (writeAlpha && (mode & M_FBA) != 0u && psm != 1u)
+        pixel |= 0x80000000u;
+    if (P.fbmsk != 0u)
+        pixel = (pixel & ~P.fbmsk) | (fb & P.fbmsk);
+    if (!writeAlpha)
+        pixel = (pixel & 0x00FFFFFFu) | (fb & 0xFF000000u);
+    if (is16)
+        pixel = rgba8888To5551(pixel);
+    if (writeRgb || writeAlpha)
+        writePixelRaw(psm, fbp, fbw, uint(xy.x), uint(xy.y), pixel);
+    if (writeDepth && (P.zbuf & 0x4000000u) != 0u)
+        writePixelRaw(zpsm, zbp, fbw, uint(xy.x), uint(xy.y), z);
+}
+
+void main()
+{
+    ivec2 xy = ivec2(pc.originX, pc.originY) + ivec2(gl_GlobalInvocationID.xy);
+    // GOW-Port: the 64 threads of a tile first test the batch's rectangles against the tile together and keep a bitmask of
+    // the primitives that touch it; each thread then walks only those, in the same ascending order.
+    ivec2 tile0 = ivec2(pc.originX, pc.originY) + ivec2(gl_WorkGroupID.xy) * 8;
+    if (gl_LocalInvocationIndex < 32u)
+        hit[gl_LocalInvocationIndex] = 0u;
+    barrier();
+    for (uint k = gl_LocalInvocationIndex; k < pc.count; k += 64u)
+    {
+        curPrim = pc.first + k;
+        if (P.rect[0] <= tile0.x + 7 && P.rect[2] >= tile0.x && P.rect[1] <= tile0.y + 7 && P.rect[3] >= tile0.y)
+            atomicOr(hit[k >> 5], 1u << (k & 31u));
+    }
+    barrier();
+    for (uint w = 0u; w < (pc.count + 31u) >> 5; ++w)
+    {
+        uint bits = hit[w];
+        while (bits != 0u)
+        {
+            uint b = uint(findLSB(bits));
+            bits &= bits - 1u;
+            curPrim = pc.first + (w << 5) + b;
+            if (xy.x >= P.rect[0] && xy.x <= P.rect[2] && xy.y >= P.rect[1] && xy.y <= P.rect[3])
+                shade(xy);
+        }
+    }
+}
+)GLSL";
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 2 || !std::freopen(argv[1], "w", stdout))
+        return 1;
+    std::fputs(kPrefix, stdout);
+    std::fputs(GSGpuShaders::kCommon, stdout);
+    std::fputs(kKernel, stdout);
+    return 0;
+}
