+// GOW-Port: Linux uses real fullscreen: raylib's borderless window leaves the desktop panel (GNOME/Wayland)
+// on top of the image. Windows keeps the borderless window, which covers the taskbar.
+static void gowToggleFullscreen()
+{
+#ifdef __linux__
+    ToggleFullscreen();
+#else
+    ToggleBorderlessWindowed();
+#endif
+}
