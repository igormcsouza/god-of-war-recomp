+// GOW-Port: register-resident pixel state. Two write-back slots hold the 32-bit VRAM words of this thread's frame/Z pixel
+// (only 32/24-bit formats: one thread owns the whole word); everything else flushes and uses memory directly.
+const uint NOKEY = 0xFFFFFFFFu;
+uint k0 = NOKEY, k1 = NOKEY, v0, v1;
+bool d0 = false, d1 = false;
+uint nextEvict = 0u;
+
+void flushAll()
+{
+    if (d0) { vram[k0] = v0; d0 = false; }
+    if (d1) { vram[k1] = v1; d1 = false; }
+}
+
+void dropAll()
+{
+    flushAll();
+    k0 = NOKEY;
+    k1 = NOKEY;
+}
+
+// Slot lookup shared by pixel and texture reads; returns the current content of word wi.
+uint cachedWord(uint wi)
+{
+    if (k0 == wi) return v0;
+    if (k1 == wi) return v1;
+    return vram[wi];
+}
+
+void putWord(uint wi, uint value, bool loaded)
+{
+    if (k0 == wi) { v0 = value; d0 = true; return; }
+    if (k1 == wi) { v1 = value; d1 = true; return; }
+    if (k0 == NOKEY || (k1 != NOKEY && nextEvict == 0u))
+    {
+        if (d0) vram[k0] = v0;
+        k0 = wi; v0 = value; d0 = true; nextEvict = 1u;
+    }
+    else
+    {
+        if (d1) vram[k1] = v1;
+        k1 = wi; v1 = value; d1 = true; nextEvict = 0u;
+    }
+}
+
+bool cacheable(uint kind) { return kind == KIND_32 || kind == KIND_24; }
+
+uint targetRead(uint psm, uint base, uint bw, uint x, uint y)
+{
+    uint f = fmtOf(psm);
+    uint kind = FMT_KIND[f];
+    if (kind == KIND_INVALID)
+        return 0u;
+    if (!cacheable(kind))
+    {
+        flushAll();
+        return loadAt(f, locate(f, base, bw, x, y));
+    }
+    uint word = cachedWord(locate(f, base, bw, x, y).x >> 2u);
+    return kind == KIND_24 ? word & 0x00FFFFFFu : word;
+}
+
+void targetWrite(uint psm, uint base, uint bw, uint x, uint y, uint value)
+{
+    uint f = fmtOf(psm);
+    uint kind = FMT_KIND[f];
+    if (kind == KIND_INVALID)
+        return;
+    uvec2 loc = locate(f, base, bw, x, y);
+    if (!cacheable(kind))
+    {
+        dropAll();
+        storeAt(f, loc, value);
+        return;
+    }
+    uint wi = loc.x >> 2u;
+    if (kind == KIND_24)
+        value = (cachedWord(wi) & 0xFF000000u) | (value & 0x00FFFFFFu);
+    putWord(wi, value, true);
+}
+
+// Texture fetch: like readPixel, but sees the words this thread has not written back yet (own-pixel feedback).
+uint texRead(uint psm, uint base, uint bw, uint x, uint y)
+{
+    uint f = fmtOf(psm);
+    uint kind = FMT_KIND[f];
+    if (kind == KIND_INVALID)
+        return 0u;
+    uvec2 loc = locate(f, base, bw, x, y);
+    uint word = cachedWord(loc.x >> 2u);
+    switch (kind)
+    {
+    case KIND_32: return word;
+    case KIND_24: return word & 0x00FFFFFFu;
+    case KIND_16: return (word >> ((loc.x & 2u) * 8u)) & 0xFFFFu;
+    case KIND_8: return (word >> ((loc.x & 3u) * 8u)) & 0xFFu;
+    }
+    return (word >> ((loc.x & 3u) * 8u + loc.y)) & 0x0Fu;
+}
