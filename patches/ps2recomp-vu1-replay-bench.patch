+// GOW-Port: GOW_VU1_REPLAY_SAMPLE=1 con GOW_VU1_REPLAY_BENCH: muestreador de RIP (SIGPROF cada 100 us de CPU) para
+// perfilar el código generado sin perf (reloj de pared: úsese con el proceso solo en un núcleo). Imprime "[vu1-sample] <desplazamiento en la imagen> <cuenta>" (nm / addr2line).
+uint64_t g_rip[1u << 22];
+volatile uint32_t g_ripN = 0;
+timer_t g_timer;
+void sampleHandler(int, siginfo_t *, void *uc)
+{
+    if (g_ripN < (1u << 22))
+        g_rip[g_ripN++] = static_cast<uint64_t>(static_cast<ucontext_t *>(uc)->uc_mcontext.gregs[REG_RIP]);
+}
+void sampleStart()
+{
+    struct sigaction sa {};
+    sa.sa_sigaction = sampleHandler;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART;
+    sigaction(SIGPROF, &sa, nullptr);
+    sigevent ev {};
+    ev.sigev_notify = SIGEV_SIGNAL;
+    ev.sigev_signo = SIGPROF;
+    timer_t timer;
+    if (timer_create(CLOCK_MONOTONIC, &ev, &timer) != 0)
+        return;
+    itimerspec its {};
+    its.it_interval.tv_nsec = its.it_value.tv_nsec = 20000;
+    timer_settime(timer, 0, &its, nullptr);
+    g_timer = timer;
+}
+void sampleStop()
+{
+    itimerspec off {};
+    timer_settime(g_timer, 0, &off, nullptr);
+    Dl_info info {};
+    dladdr(reinterpret_cast<void *>(&sampleStop), &info);
+    std::map<uint64_t, uint32_t> hist;
+    for (uint32_t k = 0; k < g_ripN; ++k)
+        ++hist[g_rip[k] - reinterpret_cast<uint64_t>(info.dli_fbase)];
+    std::fprintf(stderr, "[vu1-sample] total=%u\n", g_ripN);
+    for (const auto &[a, c] : hist)
+        std::fprintf(stderr, "[vu1-sample] %llx %u\n", static_cast<unsigned long long>(a), c);
+}
+} // namespace
+#endif
