+        // GOW-Port: sceCdRead debe tardar lo que tarda el DVD. Si completa al instante, el hilo lector de smpd
+        // adelanta el streaming de la musica de 989snd (un fichero de 1,9 MB deja sin datos al stream).
+        tc.Run("IOP sceCdRead completion is delayed by the DVD transfer time", [](TestCase &t)
+        {
+            using namespace ps2x::iop::detail;
+            iop_test::Host host;
+            host.cdImage = "image.iso";
+            host.file.assign(64u * 2048u, 0u);
+            IopMemory memory;
+            const uint32_t buffer = memory.allocate(16u * 2048u);
+            IopKernel kernel(memory);
+            kernel.reset();
+            IopCdvd cdvd(host, memory, kernel);
+            cdvd.reset();
+            IopCpuState cpu{};
+            cpu.gpr[4] = 0x4000u; // callback
+            t.IsTrue(cdvd.dispatchImport(37u, cpu), "sceCdCallback should be handled");
+            const auto readSectors = [&](uint32_t sectors)
+            {
+                cpu.gpr[4] = 0u;
+                cpu.gpr[5] = sectors;
+                cpu.gpr[6] = buffer;
+                t.IsTrue(cdvd.dispatchImport(6u, cpu), "sceCdRead should be handled");
+                t.Equals(cpu.gpr[2], 1u, "sceCdRead should succeed");
+                const auto completion = cdvd.takeCompletionCallback();
+                t.IsTrue(completion.has_value(), "sceCdRead should queue its completion callback");
+                return completion ? completion->delayCycles : 0u;
+            };
+            const uint64_t one = readSectors(1u);
+            const uint64_t sixteen = readSectors(16u);
+            t.IsTrue(one > 1000u, "one sector should take longer than an instant completion (8 MB/s = ~9400 cycles)");
+            t.IsTrue(sixteen + 16u >= one * 16u && sixteen <= one * 16u + 16u, "the transfer time should scale with the sector count");
+        });
+
