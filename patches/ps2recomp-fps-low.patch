diff --git a/ps2xRuntime/include/runtime/ps2_fps_low.h b/ps2xRuntime/include/runtime/ps2_fps_low.h
new file mode 100644
index 0000000..842fd60
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_fps_low.h
@@ -0,0 +1,42 @@
+#ifndef PS2_FPS_LOW_H
+#define PS2_FPS_LOW_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+// GOW-Port: "1% low" of the game's frame rate for the on-screen counter.
+// timesNs: ascending timestamps (ns) of the game's frames. Only intervals that end inside the last windowSec
+// seconds count, and an interval longer than gapSec is skipped: movies, loading and pauses stop the game's
+// frames, and they must not drag the figure down (a hitch shorter than gapSec still counts).
+// Result: the frame rate that corresponds to the mean frame time of the slowest 1% of those intervals, or 0 when
+// fewer than minIntervals intervals are available.
+inline double ps2FpsOnePercentLow(const std::vector<uint64_t> &timesNs, uint64_t nowNs, double windowSec,
+                                  double gapSec, size_t minIntervals = 30)
+{
+    const double windowNs = windowSec * 1e9, gapNs = gapSec * 1e9;
+    std::vector<double> intervals;
+    intervals.reserve(timesNs.size());
+    for (size_t i = 1; i < timesNs.size(); ++i)
+    {
+        if (timesNs[i] < timesNs[i - 1] || timesNs[i] > nowNs || static_cast<double>(nowNs - timesNs[i]) > windowNs)
+            continue;
+        const double dt = static_cast<double>(timesNs[i] - timesNs[i - 1]);
+        if (dt > gapNs || dt <= 0.0)
+            continue;
+        intervals.push_back(dt);
+    }
+    if (intervals.size() < minIntervals)
+        return 0.0;
+    const size_t worst = std::max<size_t>(1, static_cast<size_t>(std::ceil(intervals.size() * 0.01)));
+    std::nth_element(intervals.begin(), intervals.begin() + (worst - 1), intervals.end(), std::greater<double>());
+    double sum = 0.0;
+    for (size_t i = 0; i < worst; ++i)
+        sum += intervals[i];
+    return 1e9 / (sum / static_cast<double>(worst));
+}
+
+#endif
diff --git a/ps2xTest/src/fps_low_tests.cpp b/ps2xTest/src/fps_low_tests.cpp
new file mode 100644
index 0000000..02f837f
--- /dev/null
+++ b/ps2xTest/src/fps_low_tests.cpp
@@ -0,0 +1,65 @@
+#include "MiniTest.h"
+#include "runtime/ps2_fps_low.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace
+{
+    constexpr uint64_t kMs = 1000000ull;
+
+    // n frames starting at t0, one every stepNs; returns the timestamps
+    std::vector<uint64_t> frames(uint64_t t0, size_t n, uint64_t stepNs)
+    {
+        std::vector<uint64_t> out;
+        for (size_t i = 0; i < n; ++i)
+            out.push_back(t0 + i * stepNs);
+        return out;
+    }
+}
+
+void register_fps_low_tests()
+{
+    MiniTest::Case("FpsLow", [](TestCase &tc)
+                   {
+        tc.Run("steady 60 FPS reads about 60", [](TestCase &t)
+               {
+            const auto times = frames(0, 1000, 16667000ull);
+            const double low = ps2FpsOnePercentLow(times, times.back(), 300.0, 1.0);
+            t.IsTrue(low > 59.5 && low < 60.5, "steady 60");
+        });
+        tc.Run("one 100 ms hitch in 1000 frames pulls the 1% low down", [](TestCase &t)
+               {
+            auto times = frames(0, 500, 16667000ull);
+            const uint64_t after = times.back() + 100 * kMs;
+            const auto rest = frames(after, 500, 16667000ull);
+            times.insert(times.end(), rest.begin(), rest.end());
+            const double low = ps2FpsOnePercentLow(times, times.back(), 300.0, 1.0);
+            // slowest 1% of 999 intervals = 10 frames: (100 + 9 * 16.667) / 10 = 25 ms -> 40 FPS
+            t.IsTrue(low > 39.0 && low < 41.0, "about 40");
+        });
+        tc.Run("a movie (60 s without game frames) is not counted", [](TestCase &t)
+               {
+            auto times = frames(0, 600, 16667000ull);
+            const auto movie = frames(times.back() + 60000 * kMs, 600, 16667000ull);
+            times.insert(times.end(), movie.begin(), movie.end());
+            const double low = ps2FpsOnePercentLow(times, times.back(), 300.0, 1.0);
+            t.IsTrue(low > 59.5 && low < 60.5, "the 60 s gap is skipped");
+        });
+        tc.Run("intervals older than the window are ignored", [](TestCase &t)
+               {
+            auto times = frames(0, 400, 50000000ull); // 20 FPS, long ago
+            const uint64_t start = times.back() + 1000000 * kMs;
+            const auto recent = frames(start, 600, 16667000ull);
+            times.insert(times.end(), recent.begin(), recent.end());
+            const double low = ps2FpsOnePercentLow(times, times.back(), 300.0, 1.0);
+            t.IsTrue(low > 59.5 && low < 60.5, "only the recent 60 FPS counts");
+        });
+        tc.Run("too few frames gives 0", [](TestCase &t)
+               {
+            const auto times = frames(0, 10, 16667000ull);
+            t.Equals(ps2FpsOnePercentLow(times, times.back(), 300.0, 1.0), 0.0, "not enough data");
+            t.Equals(ps2FpsOnePercentLow({}, 0, 300.0, 1.0), 0.0, "empty");
+        });
+    });
+}
