+    // Small sprites in the four corners of the screen: they share no page and no hazard, so they are one batch.
+    std::vector<GSPrimitiveBatch> cornerScene()
+    {
+        std::vector<GSPrimitiveBatch> out;
+        for (int k = 0; k < 12; ++k)
+        {
+            auto s = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false);
+            const float x = (k & 1) ? 624.0f - 8 * (k / 4) : 4.0f + 8 * (k / 4);
+            const float y = (k & 2) ? 430.0f - 8 * (k / 4) : 4.0f + 8 * (k / 4);
+            vertex(s, 0, x, y, 0); vertex(s, 1, x + 8, y + 8, 0x80102030u + 0x01010101u * uint32_t(k));
+            out.push_back(s);
+        }
+        return out;
+    }
