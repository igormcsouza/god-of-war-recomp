+    // GOW-Port: batching. A scene with its VRAM and the number of GPU dispatches (GPU timestamps, enabled by the stats
+    // variable before the backend exists; 0 when the device has none).
+    struct Counted
+    {
+        std::vector<uint8_t> vram;
+        uint64_t dispatches = 0, prims = 0;
+    };
+
+    template <typename Backend>
+    Counted renderCounted(Backend &backend, const std::vector<GSPrimitiveBatch> &batches)
+    {
+        Counted r;
+        r.vram = noise();
+        backend.Initialize(r.vram.data(), uint32_t(r.vram.size()));
+        for (const auto &b : batches)
+            backend.Submit(b);
+        backend.Flush();
+        return r;
+    }
+
+    void setStatsEnv(bool on)
+    {
+#ifdef _WIN32
+        _putenv_s("PS2X_GS_VULKAN_STATS", on ? "1" : "");
+#else
+        if (on)
+            setenv("PS2X_GS_VULKAN_STATS", "1", 1);
+        else
+            unsetenv("PS2X_GS_VULKAN_STATS");
+#endif
+    }
+
+    // A flat sprite that only tests the Z buffer at page 480 (or writes it), then a textured sprite that reads the same
+    // pages as colour (GoW keeps alpha textures in the unused part of the Z buffer).
+    std::vector<GSPrimitiveBatch> zTextureScene(bool writeZ)
+    {
+        std::vector<GSPrimitiveBatch> out;
+        auto a = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false);
+        a.state.context.test = 0x10000u | (2u << 17);
+        a.state.context.zbuf.zmask = !writeZ;
+        vertex(a, 0, 64, 32, 0); vertex(a, 1, 160, 96, 0x80C0A060u);
+        a.vertices[1].z = 0x100;
+        out.push_back(a);
+        auto b = frameTex(GS_PRIM_SPRITE, false);
+        b.state.context.test = 0x10000u | (2u << 17);
+        b.state.context.zbuf = {480, GS_PSM_Z32, true};
+        b.state.context.tex0.tbp0 = 480 * 32;
+        vertex(b, 0, 200, 200, 0x80808080u); vertex(b, 1, 260, 240, 0x80808080u);
+        uv(b, 0, 20.5f, 20.5f, 1.0f); uv(b, 1, 80.5f, 60.5f, 1.0f);
+        b.vertices[1].z = 0x100;
+        out.push_back(b);
+        return out;
+    }
