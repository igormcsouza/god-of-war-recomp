+// GOW-Port: staging slots for two-phase Present. Shared with the pending frames, so a frame resolved after the
+// backend is gone still has valid buffers. state: 0 free, 1 pending (owned by a frame), 2 abandoned (GPU copy may be in flight).
+namespace
+{
+struct PresentRing
+{
+    static constexpr uint32_t kSlots = 3;
+    VkShared &s;
+    VkBuffer buf[kSlots]{};
+    VkDeviceMemory mem[kSlots]{};
+    void *map[kSlots]{};
+    VkFence fence[kSlots]{};
+    std::atomic<int> state[kSlots]{};
+    uint32_t next = 0;
+    bool ok = false;
+    explicit PresentRing(VkShared &shared) : s(shared)
+    {
+        VkFenceCreateInfo fi{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        ok = true;
+        for (uint32_t i = 0; i < kSlots && ok; ++i)
+            ok = makeHostBuffer(s, GSSwizzle::kMemorySize, buf[i], mem[i], &map[i]) &&
+                 vkCreateFence(s.device, &fi, nullptr, &fence[i]) == VK_SUCCESS;
+    }
+    ~PresentRing()
+    {
+        for (uint32_t i = 0; i < kSlots; ++i)
+        {
+            if (fence[i])
+            {
+                if (state[i].load() == 2) // abandoned: its copy was submitted, wait before destroying
+                    vkWaitForFences(s.device, 1, &fence[i], VK_TRUE, UINT64_MAX);
+                vkDestroyFence(s.device, fence[i], nullptr);
+            }
+            if (buf[i])
+                vkDestroyBuffer(s.device, buf[i], nullptr);
+            if (mem[i])
+                vkFreeMemory(s.device, mem[i], nullptr);
+        }
+    }
+    // Worker side: a free slot, or an abandoned one whose copy has landed. -1 = none.
+    int acquire()
+    {
+        for (uint32_t k = 0; k < kSlots; ++k)
+        {
+            const uint32_t i = (next + k) % kSlots;
+            int st = state[i].load(std::memory_order_acquire);
+            if (st == 2 && vkGetFenceStatus(s.device, fence[i]) == VK_SUCCESS)
+            {
+                vkResetFences(s.device, 1, &fence[i]);
+                st = 0;
+            }
+            if (st == 0)
+            {
+                next = (i + 1) % kSlots;
+                return static_cast<int>(i);
+            }
+        }
+        return -1;
+    }
+};
+} // namespace
