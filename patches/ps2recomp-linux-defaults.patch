diff --git a/ps2xRuntime/include/runtime/linux_defaults.h b/ps2xRuntime/include/runtime/linux_defaults.h
new file mode 100644
index 0000000..7fd413b
--- /dev/null
+++ b/ps2xRuntime/include/runtime/linux_defaults.h
@@ -0,0 +1,18 @@
+#pragma once
+// GOW-Port: Linux threading defaults. The intro/title measured 5.6 -> 6.6 FPS (game time 0.09 -> 0.39 s/s) with the VU1
+// worker, the GS front-end thread and asynchronous GS FINISH. Each knob keeps its own opt-out: set it to 0 (or, for
+// GOW_GS_FINISH_ASINCRONO, anything but 1) before launching. Existing values are never overwritten.
+#include <cstdlib>
+
+namespace ps2x
+{
+    inline void ApplyLinuxThreadingDefaults()
+    {
+#if defined(__linux__)
+        static const char *const kDefaults[][2] = {
+            {"PS2X_VU1_HILO", "1"}, {"PS2X_GS_FRENTE", "1"}, {"GOW_GS_FINISH_ASINCRONO", "1"}};
+        for (const auto &kv : kDefaults)
+            ::setenv(kv[0], kv[1], 0);
+#endif
+    }
+}
diff --git a/ps2xTest/src/linux_defaults_tests.cpp b/ps2xTest/src/linux_defaults_tests.cpp
new file mode 100644
index 0000000..c56f15e
--- /dev/null
+++ b/ps2xTest/src/linux_defaults_tests.cpp
@@ -0,0 +1,27 @@
+#include "MiniTest.h"
+#include "runtime/linux_defaults.h"
+
+#include <cstdlib>
+#include <cstring>
+
+void register_linux_defaults_tests()
+{
+#if defined(__linux__)
+    MiniTest::Case("LinuxDefaults", [](TestCase &tc)
+    {
+        tc.Run("threading knobs default on but never overwrite an explicit value", [](TestCase &t)
+        {
+            ::unsetenv("PS2X_VU1_HILO");
+            ::unsetenv("PS2X_GS_FRENTE");
+            ::setenv("GOW_GS_FINISH_ASINCRONO", "0", 1);
+            ps2x::ApplyLinuxThreadingDefaults();
+            t.IsTrue(std::strcmp(std::getenv("PS2X_VU1_HILO"), "1") == 0, "VU1 worker defaults on");
+            t.IsTrue(std::strcmp(std::getenv("PS2X_GS_FRENTE"), "1") == 0, "GS front end defaults on");
+            t.IsTrue(std::strcmp(std::getenv("GOW_GS_FINISH_ASINCRONO"), "0") == 0, "explicit value is kept");
+            ::unsetenv("PS2X_VU1_HILO");
+            ::unsetenv("PS2X_GS_FRENTE");
+            ::unsetenv("GOW_GS_FINISH_ASINCRONO");
+        });
+    });
+#endif
+}
