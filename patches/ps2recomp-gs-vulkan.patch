diff --git a/ps2xRuntime/include/runtime/gs/gs_vulkan_backend.h b/ps2xRuntime/include/runtime/gs/gs_vulkan_backend.h
new file mode 100644
index 0000000..58b51e8
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_vulkan_backend.h
@@ -0,0 +1,65 @@
+// GOW-Port: Vulkan GS backend (phases A-B). See docs/VULKAN.md in the God of War port repository.
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+#include "runtime/gs/gs_backend_state.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+// Host VRAM stays authoritative: the backend wraps GSCpuBackend and runs the primitives it supports
+// as Vulkan compute dispatches on a GPU copy of VRAM. Every other call first waits for the GPU and
+// copies VRAM back, then goes to the CPU backend (transfers, CLUT, readback, presentation).
+class GSVulkanBackend final : public GSRasterBackend, public GSBackendStateAccess
+{
+public:
+    GSVulkanBackend();
+    ~GSVulkanBackend() override;
+
+    // False when no usable Vulkan device exists; the caller then uses GSCpuBackend.
+    bool IsReady() const;
+    uint64_t GpuPrimitives() const { return m_gpuPrimitives; }
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+    bool ExportState(GSBackendState &out) override;
+    bool ImportState(const GSBackendState &state) override;
+
+private:
+    struct Impl;
+    // Waits for recorded GPU work and copies the GPU VRAM back to host VRAM.
+    // `cause` names what ended the GPU run (PS2X_GS_VULKAN_STATS).
+    void Finish(const char *cause = "finish") const;
+    // nullptr when the primitive was recorded for the GPU, else the reason for the CPU fallback.
+    const char *RecordGpu(const GSPrimitiveBatch &batch);
+
+    std::unique_ptr<Impl> m_impl;
+    GSCpuBackend m_cpu;
+    uint8_t *m_vram = nullptr;
+    uint32_t m_vramSize = 0;
+    uint64_t m_gpuPrimitives = 0;
+    mutable std::recursive_mutex m_mutex;
+};
diff --git a/ps2xRuntime/src/lib/gs/gpu/gs_vulkan_backend.cpp b/ps2xRuntime/src/lib/gs/gpu/gs_vulkan_backend.cpp
new file mode 100644
index 0000000..52e7cf2
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gpu/gs_vulkan_backend.cpp
@@ -0,0 +1,1436 @@
+// GOW-Port: Vulkan GS backend, phases A-C (textured and untextured sprites and triangles on the GPU in batches,
+// host VRAM imported zero-copy, everything else on GSCpuBackend). Design notes: docs/VULKAN.md in the port repository.
+#include "runtime/gs/gs_vulkan_backend.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "runtime/gs/ps2_gs_common.h"
+#include "runtime/gs/ps2_gs_memory.h"
+#include "../gs_sprite_rules.h"
+#include "../gs_triangle_rules.h"
+#include "gs_vulkan_raster_spv.h" // generated by gs_vulkan_shader_export + glslangValidator
+
+#include <vulkan/vulkan.h>
+#include <xmmintrin.h>
+
+#include <algorithm>
+#include <array>
+#include <bitset>
+#include <cctype>
+#include <cmath>
+#include <chrono>
+#include <cstdio>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <cstdlib>
+#include <cstring>
+
+namespace
+{
+    // Must match struct Prim of the kernel in gs_vulkan_shader_export.cpp (std430).
+    struct PrimRecord
+    {
+        int64_t ea[3];
+        int64_t eb[3];
+        int64_t ec[3];
+        int64_t area;
+        int32_t rect[4];
+        uint32_t frame;
+        uint32_t mode;
+        uint32_t fbmsk;
+        uint32_t color[3];
+        uint32_t tex;
+        uint32_t tsize;
+        uint32_t tmode;
+        uint32_t texa;
+        uint32_t clampLo;
+        uint32_t clampHi;
+        float axis[4];
+        float attr[12];
+        uint32_t alpha;
+        uint32_t test;
+        uint32_t zbuf;
+        uint32_t z;
+        int32_t zd[2];
+    };
+    static_assert(sizeof(PrimRecord) == 232, "std430 layout of struct Prim");
+
+    constexpr uint32_t kClutVersions = 64u; // GOW-Port: CLUT snapshots per run (tmode bits 25..31 name one)
+    constexpr uint32_t kTriangle = 0x100u;
+    constexpr uint32_t kIip = 0x200u;
+    constexpr uint32_t kFba = 0x400u;
+    constexpr uint32_t kBias0 = 0x800u; // 0x800, 0x1000, 0x2000
+    constexpr uint32_t kTme = 0x4000u;
+    constexpr uint32_t kFst = 0x8000u;
+    constexpr uint32_t kLinear = 0x10000u;
+    constexpr uint32_t kZip = 0x20000u;
+    constexpr uint32_t kAbe = 0x10000u; // PrimRecord::alpha flags
+    constexpr uint32_t kPabe = 0x20000u;
+    constexpr uint32_t kColclamp = 0x40000u;
+    // ponytail: fixed record ring per GPU run (~3.4 MB); a full ring ends the run.
+    constexpr uint32_t kMaxPrims = 16384u;
+    constexpr uint32_t kMaxBatch = 1024u;
+    constexpr uint32_t kQueriesPerCmd = 1056u; // begin/end of the command buffer + a begin/end pair per dispatch (stats only)
+    constexpr uint32_t kMaxCmds = 32u;      // command buffers per GPU run (partial submissions)
+    constexpr uint32_t kSubmitEvery = 512u; // primitives between partial submissions
+
+    struct Push
+    {
+        int32_t originX, originY;
+        uint32_t first, count;
+    };
+    using PageSet = std::bitset<512>;
+
+    struct VkShared
+    {
+        VkInstance instance = VK_NULL_HANDLE;
+        VkPhysicalDevice phys = VK_NULL_HANDLE;
+        VkDevice device = VK_NULL_HANDLE;
+        VkQueue queue = VK_NULL_HANDLE;
+        uint32_t family = 0;
+        uint32_t timestampBits = 0;   // GOW-Port: timestampValidBits of the queue family (0 = no timestamps)
+        float timestampPeriod = 0.f;  // ns per tick
+        VkPhysicalDeviceMemoryProperties memory{};
+        VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+        VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+        VkPipeline pipeline = VK_NULL_HANDLE;
+        PFN_vkGetMemoryHostPointerPropertiesEXT getHostPointerProps = nullptr; // VK_EXT_external_memory_host
+        VkBuffer swizzle = VK_NULL_HANDLE;
+        VkDeviceMemory swizzleMemory = VK_NULL_HANDLE;
+        std::mutex queueMutex;
+    };
+
+    // Host-visible storage buffer; prefers cached memory so the VRAM readback memcpy stays fast.
+    bool makeHostBuffer(VkShared &s, VkDeviceSize size, VkBuffer &buffer, VkDeviceMemory &memory, void **mapped)
+    {
+        VkBufferCreateInfo info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+        info.size = size;
+        info.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+        if (vkCreateBuffer(s.device, &info, nullptr, &buffer) != VK_SUCCESS)
+            return false;
+        VkMemoryRequirements req{};
+        vkGetBufferMemoryRequirements(s.device, buffer, &req);
+        const VkMemoryPropertyFlags coherent = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+        uint32_t type = UINT32_MAX;
+        for (VkMemoryPropertyFlags want : {coherent | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, coherent})
+            for (uint32_t i = 0; i < s.memory.memoryTypeCount && type == UINT32_MAX; ++i)
+                if ((req.memoryTypeBits & (1u << i)) && (s.memory.memoryTypes[i].propertyFlags & want) == want)
+                    type = i;
+        if (type == UINT32_MAX)
+            return false;
+        VkMemoryAllocateInfo alloc{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        alloc.allocationSize = req.size;
+        alloc.memoryTypeIndex = type;
+        return vkAllocateMemory(s.device, &alloc, nullptr, &memory) == VK_SUCCESS &&
+               vkBindBufferMemory(s.device, buffer, memory, 0) == VK_SUCCESS &&
+               vkMapMemory(s.device, memory, 0, size, 0, mapped) == VK_SUCCESS;
+    }
+
+    const char *initShared(VkShared &s)
+    {
+        VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+        app.pApplicationName = "ps2x-gs";
+        app.apiVersion = VK_API_VERSION_1_1;
+        VkInstanceCreateInfo instanceInfo{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+        instanceInfo.pApplicationInfo = &app;
+        if (vkCreateInstance(&instanceInfo, nullptr, &s.instance) != VK_SUCCESS)
+            return "vkCreateInstance failed";
+
+        uint32_t count = 0;
+        vkEnumeratePhysicalDevices(s.instance, &count, nullptr);
+        std::vector<VkPhysicalDevice> devices(count);
+        vkEnumeratePhysicalDevices(s.instance, &count, devices.data());
+        // GOW-Port: explicit device choice. Default prefers discrete, then integrated, virtual, CPU. VRAM is host memory
+        // (imported zero-copy with VK_EXT_external_memory_host), so any device works. PS2X_VK_DEVICE=<index or
+        // case-insensitive substring of the device name> forces one; no match falls back to the default with a warning.
+        const VkPhysicalDeviceType order[] = {VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU, VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU,
+                                              VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU, VK_PHYSICAL_DEVICE_TYPE_CPU};
+        const char *forcedEnv = std::getenv("PS2X_VK_DEVICE");
+        std::string forced = forcedEnv ? forcedEnv : "";
+        const auto lower = [](std::string v) { for (char &c : v) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c))); return v; };
+        const bool forcedIsIndex = !forced.empty() && forced.find_first_not_of("0123456789") == std::string::npos;
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            VkPhysicalDeviceProperties props{};
+            vkGetPhysicalDeviceProperties(devices[i], &props);
+            std::fprintf(stderr, "[gow-gs] Vulkan device %u: %s (type %d)\n", i, props.deviceName, static_cast<int>(props.deviceType));
+        }
+        for (int attempt = 0; attempt < 2 && !s.phys; ++attempt)
+        {
+            const bool useForced = attempt == 0 && !forced.empty();
+            if (attempt == 1 && !forced.empty())
+                std::fprintf(stderr, "[gow-gs] PS2X_VK_DEVICE=%s matched no usable device; using the default choice\n", forced.c_str());
+            for (size_t pass = 0; pass < std::size(order) && !s.phys; ++pass)
+                for (uint32_t i = 0; i < count && !s.phys; ++i)
+                {
+                    VkPhysicalDeviceProperties props{};
+                    VkPhysicalDeviceFeatures features{};
+                    vkGetPhysicalDeviceProperties(devices[i], &props);
+                    vkGetPhysicalDeviceFeatures(devices[i], &features);
+                    if (useForced ? (forcedIsIndex ? i != static_cast<uint32_t>(std::atoi(forced.c_str()))
+                                                   : lower(props.deviceName).find(lower(forced)) == std::string::npos)
+                                  : props.deviceType != order[pass])
+                        continue;
+                    if (!features.shaderInt64)
+                        continue;
+                    uint32_t families = 0;
+                    vkGetPhysicalDeviceQueueFamilyProperties(devices[i], &families, nullptr);
+                    std::vector<VkQueueFamilyProperties> familyProps(families);
+                    vkGetPhysicalDeviceQueueFamilyProperties(devices[i], &families, familyProps.data());
+                    for (uint32_t f = 0; f < families && !s.phys; ++f)
+                        if (familyProps[f].queueFlags & VK_QUEUE_COMPUTE_BIT)
+                        {
+                            s.phys = devices[i];
+                            s.family = f;
+                            s.timestampBits = familyProps[f].timestampValidBits;
+                            s.timestampPeriod = props.limits.timestampPeriod;
+                            std::fprintf(stderr, "[gow-gs] Vulkan device: %s (index %u, %s%s)\n", props.deviceName, i,
+                                         props.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU     ? "discrete"
+                                         : props.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU ? "integrated"
+                                         : props.deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU            ? "cpu"
+                                                                                                      : "other",
+                                         useForced ? ", forced" : "");
+                        }
+                }
+        }
+        if (!s.phys)
+            return "no Vulkan device with compute and shaderInt64";
+        vkGetPhysicalDeviceMemoryProperties(s.phys, &s.memory);
+
+        const float priority = 1.0f;
+        VkDeviceQueueCreateInfo queueInfo{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+        queueInfo.queueFamilyIndex = s.family;
+        queueInfo.queueCount = 1;
+        queueInfo.pQueuePriorities = &priority;
+        VkPhysicalDeviceFeatures enabled{};
+        enabled.shaderInt64 = VK_TRUE;
+        // GOW-Port: importing the host VRAM array avoids copying 4 MiB each way per GPU run.
+        const char *hostImport = VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME;
+        uint32_t extensionCount = 0;
+        vkEnumerateDeviceExtensionProperties(s.phys, nullptr, &extensionCount, nullptr);
+        std::vector<VkExtensionProperties> extensions(extensionCount);
+        vkEnumerateDeviceExtensionProperties(s.phys, nullptr, &extensionCount, extensions.data());
+        bool canImport = false;
+        for (const auto &e : extensions)
+            canImport |= std::strcmp(e.extensionName, hostImport) == 0;
+        VkDeviceCreateInfo deviceInfo{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+        deviceInfo.queueCreateInfoCount = 1;
+        deviceInfo.pQueueCreateInfos = &queueInfo;
+        deviceInfo.pEnabledFeatures = &enabled;
+        deviceInfo.enabledExtensionCount = canImport ? 1u : 0u;
+        deviceInfo.ppEnabledExtensionNames = &hostImport;
+        if (vkCreateDevice(s.phys, &deviceInfo, nullptr, &s.device) != VK_SUCCESS)
+            return "vkCreateDevice failed";
+        vkGetDeviceQueue(s.device, s.family, 0, &s.queue);
+        if (canImport)
+            s.getHostPointerProps = reinterpret_cast<PFN_vkGetMemoryHostPointerPropertiesEXT>(
+                vkGetDeviceProcAddr(s.device, "vkGetMemoryHostPointerPropertiesEXT"));
+
+        VkDescriptorSetLayoutBinding bindings[4]{};
+        for (uint32_t i = 0; i < 4; ++i)
+        {
+            bindings[i].binding = i; // 0 = VRAM, 1 = swizzle tables, 2 = CLUT (kCommon), 3 = primitive records
+            bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+            bindings[i].descriptorCount = 1;
+            bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        }
+        VkDescriptorSetLayoutCreateInfo setInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        setInfo.bindingCount = 4;
+        setInfo.pBindings = bindings;
+        VkPushConstantRange range{VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(Push)};
+        VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        layoutInfo.setLayoutCount = 1;
+        layoutInfo.pSetLayouts = &s.setLayout;
+        layoutInfo.pushConstantRangeCount = 1;
+        layoutInfo.pPushConstantRanges = &range;
+        if (vkCreateDescriptorSetLayout(s.device, &setInfo, nullptr, &s.setLayout) != VK_SUCCESS ||
+            vkCreatePipelineLayout(s.device, &layoutInfo, nullptr, &s.pipelineLayout) != VK_SUCCESS)
+            return "pipeline layout creation failed";
+
+        VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        moduleInfo.codeSize = sizeof(kGsVulkanRasterSpv);
+        moduleInfo.pCode = kGsVulkanRasterSpv;
+        VkShaderModule module = VK_NULL_HANDLE;
+        if (vkCreateShaderModule(s.device, &moduleInfo, nullptr, &module) != VK_SUCCESS)
+            return "vkCreateShaderModule failed";
+        VkComputePipelineCreateInfo pipelineInfo{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+        pipelineInfo.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+        pipelineInfo.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+        pipelineInfo.stage.module = module;
+        pipelineInfo.stage.pName = "main";
+        pipelineInfo.layout = s.pipelineLayout;
+        const VkResult pipelineResult = vkCreateComputePipelines(s.device, VK_NULL_HANDLE, 1, &pipelineInfo, nullptr, &s.pipeline);
+        vkDestroyShaderModule(s.device, module, nullptr);
+        if (pipelineResult != VK_SUCCESS)
+            return "vkCreateComputePipelines failed";
+
+        // Same page tables and order as the OpenGL backend (TABLE_* defines in the exported shader).
+        GSSwizzle::GetFormat(0u);
+        using GSMem::PixelStorageMode;
+        const std::pair<PixelStorageMode, uint32_t> tables[] = {
+            {PixelStorageMode::C32, 65536u}, {PixelStorageMode::Z32, 65536u}, {PixelStorageMode::C16, 131072u},
+            {PixelStorageMode::C16S, 131072u}, {PixelStorageMode::Z16, 131072u}, {PixelStorageMode::Z16S, 131072u},
+            {PixelStorageMode::P8, 262144u}, {PixelStorageMode::P4, 524288u}};
+        std::vector<uint16_t> swizzle;
+        for (const auto &table : tables)
+        {
+            const uint16_t *data = GSMem::PageTableData(table.first);
+            swizzle.insert(swizzle.end(), data, data + table.second);
+        }
+        // ponytail: host-visible swizzle table; move to device-local memory if a discrete GPU needs it.
+        void *mapped = nullptr;
+        if (!makeHostBuffer(s, swizzle.size() * sizeof(uint16_t), s.swizzle, s.swizzleMemory, &mapped))
+            return "swizzle buffer allocation failed";
+        std::memcpy(mapped, swizzle.data(), swizzle.size() * sizeof(uint16_t));
+        return nullptr;
+    }
+
+    // ponytail: one process-wide device, never destroyed (avoids static destruction order issues).
+    VkShared *shared()
+    {
+        static VkShared *const instance = []() -> VkShared *
+        {
+            auto *s = new VkShared;
+            if (const char *error = initShared(*s))
+            {
+                std::fprintf(stderr, "[gow-gs] Vulkan unavailable: %s\n", error);
+                return nullptr;
+            }
+            return s;
+        }();
+        return instance;
+    }
+
+    uint32_t packColor(const GSVertex &v)
+    {
+        return static_cast<uint32_t>(v.r) | (static_cast<uint32_t>(v.g) << 8u) | (static_cast<uint32_t>(v.b) << 16u) |
+               (static_cast<uint32_t>(v.a) << 24u);
+    }
+
+    float fabsQ(float q)
+    {
+        return (std::fabs(q) > 1.0e-8f) ? q : 1.0f; // gs_cpu_backend.cpp
+    }
+
+    // Page geometry (width, height in pixels/texels) of the GS formats, for the hazard sets below.
+    void pageSize(uint32_t psm, uint32_t &w, uint32_t &h)
+    {
+        switch (psm)
+        {
+        case 0x13: case 0x1B: w = 128; h = 64; break;                      // T8, T8H
+        case 0x14: case 0x24: case 0x2C: w = 128; h = 128; break;          // T4, T4HL, T4HH
+        case 0x02: case 0x0A: case 0x32: case 0x3A: w = 64; h = 64; break; // 16 bit
+        default: w = 64; h = 32; break;                                    // 32/24 bit
+        }
+    }
+
+    // GS pages (8 KiB, 512 in VRAM) covered by pixels [x0,x1] x [y0,y1] of a buffer. Conservative.
+    void bufferPages(PageSet &out, uint32_t basePage, uint32_t bw, uint32_t psm, int x0, int y0, int x1, int y1)
+    {
+        uint32_t pw, ph;
+        pageSize(psm, pw, ph);
+        bw = std::max(bw, 1u);
+        for (uint32_t py = static_cast<uint32_t>(y0) / ph; py <= static_cast<uint32_t>(y1) / ph; ++py)
+            for (uint32_t px = static_cast<uint32_t>(x0) / pw; px <= static_cast<uint32_t>(x1) / pw; ++px)
+                out.set((basePage + py * bw + px) & 511u);
+    }
+
+
+    // GOW-Port: frame/Z alias proof. The shader already addresses the frame with its PSM and Z with the Z PSM, so the only
+    // danger is two different pixels owning one word. 32-bit frame (CT32/CT24) and Z (Z32/Z24) share the column layout and
+    // differ only in the block table, so words are compared per 8x8 pixel block: a frame block may match a Z block only of
+    // the same pixel block (then each word belongs to one thread). Any other match -> CPU row order.
+    static bool frameZAliasSafe(uint32_t fbBlock, uint32_t zBlock, uint32_t bw, uint32_t fpsm, uint32_t zpsm, int x0, int y0, int x1, int y1)
+    {
+        static constexpr uint8_t kZBlock[4][8] = {{24, 25, 28, 29, 8, 9, 12, 13}, {26, 27, 30, 31, 10, 11, 14, 15},
+                                                  {16, 17, 20, 21, 0, 1, 4, 5}, {18, 19, 22, 23, 2, 3, 6, 7}};
+        static constexpr uint8_t kCBlock[4][8] = {{0, 1, 4, 5, 16, 17, 20, 21}, {2, 3, 6, 7, 18, 19, 22, 23},
+                                                  {8, 9, 12, 13, 24, 25, 28, 29}, {10, 11, 14, 15, 26, 27, 30, 31}};
+        if ((fpsm != GS_PSM_CT32 && fpsm != GS_PSM_CT24) || (zpsm != GS_PSM_Z32 && zpsm != GS_PSM_Z24))
+            return false;
+        bw = std::max(bw, 1u);
+        const int bx0 = x0 >> 3, bx1 = x1 >> 3, by0 = y0 >> 3, by1 = y1 >> 3;
+        if ((bx1 - bx0 + 1) * (by1 - by0 + 1) > 20000)
+            return false;
+        auto blockId = [&](uint32_t base, const uint8_t (*tab)[8], int bx, int by) {
+            const uint32_t page = (base >> 5) + static_cast<uint32_t>((by >> 2) * static_cast<int>(bw) + (bx >> 3));
+            return (page << 5) + (base & 31u) + tab[by & 3][bx & 7];
+        };
+        std::unordered_map<uint32_t, uint32_t> zOwner; // Z block -> pixel block (by * 4096 + bx)
+        for (int by = by0; by <= by1; ++by)
+            for (int bx = bx0; bx <= bx1; ++bx)
+                zOwner[blockId(zBlock, kZBlock, bx, by)] = static_cast<uint32_t>(by * 4096 + bx);
+        for (int by = by0; by <= by1; ++by)
+            for (int bx = bx0; bx <= bx1; ++bx)
+            {
+                const auto it = zOwner.find(blockId(fbBlock, kCBlock, bx, by));
+                if (it != zOwner.end() && it->second != static_cast<uint32_t>(by * 4096 + bx))
+                    return false;
+            }
+        return true;
+    }
+
+
+    // GOW-Port: GS pixel layout class: CT32/CT24/Z32/Z24 share one swizzle, CT16 and Z16 another, CT16S and Z16S a third.
+    uint32_t layoutClass(uint32_t psm)
+    {
+        const uint32_t c = psm & 0xFu;
+        return c <= 1u ? 0u : c;
+    }
+
+    bool sameLayoutPsm(uint32_t psm)
+    {
+        return psm == 0x00u || psm == 0x01u || psm == 0x02u || psm == 0x0Au || psm == 0x30u || psm == 0x31u ||
+               psm == 0x32u || psm == 0x3Au;
+    }
+
+    // GOW-Port: the texture is the frame buffer itself (same base, width and pixel layout).
+    bool sameBuffer(const GSDrawState &state, const GSContext &ctx)
+    {
+        const GSTex0Reg &tex = state.context.tex0;
+        return sameLayoutPsm(tex.psm) && layoutClass(tex.psm) == layoutClass(ctx.frame.psm) &&
+               tex.tbp0 == GSInternal::framePageBaseToBlock(ctx.frame.fbp) && tex.tbw == std::max<uint32_t>(ctx.frame.fbw, 1u);
+    }
+
+    // GOW-Port: true when every pixel of a textured FST sprite samples exactly the texel at its own frame address, so the
+    // thread reads the pixel it is about to write (read-then-write by one thread: no cross-thread hazard). The UV of
+    // each column and row are computed with the shader's own float expressions (the sprite axes are independent) and
+    // must land on the pixel itself: nearest samples floor(u) == x, bilinear u - 0.5 == x exactly (zero weights).
+    bool spriteReadsOwnPixel(const GSDrawState &state, const float axis[4], const float attr[4], int x0, int y0, int x1, int y1)
+    {
+        const GSContext &ctx = state.context;
+        const GSTex0Reg &tex = ctx.tex0;
+        if (!state.prim.fst || !sameLayoutPsm(tex.psm) || layoutClass(tex.psm) != layoutClass(ctx.frame.psm))
+            return false;
+        if ((ctx.clamp & 3u) > 1u || ((ctx.clamp >> 2) & 3u) > 1u) // only REPEAT/CLAMP, which leave in-range texels alone
+            return false;
+        if (tex.tbp0 != GSInternal::framePageBaseToBlock(ctx.frame.fbp) || tex.tbw != std::max<uint32_t>(ctx.frame.fbw, 1u))
+            return false;
+        if (x1 >= static_cast<int>(state.textureWidth) || y1 >= static_cast<int>(state.textureHeight) || x0 < 0 || y0 < 0)
+            return false;
+        auto axisOk = [&](int lo, int hi, float origin, float scale, float a0, float a1) {
+            for (int p = lo; p <= hi; ++p)
+            {
+                volatile float tx = (static_cast<float>(p) - origin) * scale;
+                volatile float u = a0 + (a1 - a0) * tx;
+                volatile float fu = u * 16.0f + 0.5f;
+                const int q = std::clamp(static_cast<int>(fu), 0, 0xFFFF);
+                if (state.linearFilter ? (q != p * 16 + 8) : ((q >> 4) != p))
+                    return false;
+            }
+            return true;
+        };
+        return axisOk(x0, x1, axis[0], axis[1], attr[0], attr[2]) && axisOk(y0, y1, axis[2], axis[3], attr[1], attr[3]);
+    }
+
+
+    // GOW-Port: the triangle version of spriteReadsOwnPixel. Triangles interpolate at the integer pixel position, so if
+    // every vertex has u = x + cu and v = y + cv in 12.4 raw units the texel coordinate of pixel (px,py) is
+    // (16px + cu, 16py + cv) up to the float error of the interpolation (< 1 raw unit). With nearest filtering and
+    // cu, cv in [1,14] the texel index is exactly the pixel.
+    bool triangleReadsOwnPixel(const GSDrawState &state, const GSVertex *v, const int64_t xy[6], int x0, int y0, int x1, int y1)
+    {
+        const GSContext &ctx = state.context;
+        const GSTex0Reg &tex = ctx.tex0;
+        if (!state.prim.fst || state.linearFilter || !sameLayoutPsm(tex.psm) || layoutClass(tex.psm) != layoutClass(ctx.frame.psm))
+            return false;
+        if ((ctx.clamp & 3u) > 1u || ((ctx.clamp >> 2) & 3u) > 1u)
+            return false;
+        if (tex.tbp0 != GSInternal::framePageBaseToBlock(ctx.frame.fbp) || tex.tbw != std::max<uint32_t>(ctx.frame.fbw, 1u))
+            return false;
+        if (x1 >= static_cast<int>(state.textureWidth) || y1 >= static_cast<int>(state.textureHeight) || x0 < 0 || y0 < 0)
+            return false;
+        const int64_t cu = static_cast<int64_t>(v[0].u) - xy[0], cv = static_cast<int64_t>(v[0].v) - xy[1];
+        if (cu < 1 || cu > 14 || cv < 1 || cv > 14)
+            return false;
+        for (int i = 1; i < 3; ++i)
+            if (static_cast<int64_t>(v[i].u) - xy[i * 2] != cu || static_cast<int64_t>(v[i].v) - xy[i * 2 + 1] != cv)
+                return false;
+        return true;
+    }
+
+    // Pages the sampler may read: the whole texture rectangle plus one page of slack for unaligned bases.
+    void texturePages(PageSet &out, const GSDrawState &state, const uint32_t *bb = nullptr)
+    {
+        const GSTex0Reg &tex = state.context.tex0;
+        uint32_t pw, ph;
+        pageSize(tex.psm, pw, ph);
+        const uint32_t perRow = std::max(1u, (std::max<uint32_t>(tex.tbw, 1u) * 64u + pw - 1u) / pw);
+        if (bb) // GOW-Port: only the texels the sprite can sample (bb = x0,y0,x1,y1), not the declared texture size
+        {
+            const uint32_t base = tex.tbp0 >> 5;
+            for (uint32_t r = bb[1] / ph; r <= bb[3] / ph; ++r)
+                for (uint32_t c = bb[0] / pw; c <= std::min(perRow - 1u, bb[2] / pw); ++c)
+                {
+                    out.set((base + r * perRow + c) & 511u);
+                    out.set((base + r * perRow + c + 1u) & 511u); // slack for block-unaligned bases
+                }
+            return;
+        }
+        const uint32_t cols = std::min(perRow, (static_cast<uint32_t>(state.textureWidth) + pw - 1u) / pw);
+        const uint32_t rows = (static_cast<uint32_t>(state.textureHeight) + ph - 1u) / ph;
+        const uint32_t base = tex.tbp0 >> 5;
+        for (uint32_t r = 0; r < rows; ++r)
+            for (uint32_t c = 0; c < cols; ++c)
+                out.set((base + r * perRow + c) & 511u);
+        out.set((base + rows * perRow) & 511u);
+    }
+
+    // GOW-Port: GOW_VK_NO_FBOPT=1 restores the page-level feedback rules and the DATE fallback (A/B timing, screenshots).
+    bool noFeedbackOpt()
+    {
+        static const bool v = [] { const char *e = std::getenv("GOW_VK_NO_FBOPT"); return e && *e && *e != '0'; }();
+        return v;
+    }
+
+    // The state where GSCpuBackend::WritePixel reduces to "alpha test, blend, honour FBMSK/FBA, store color". Returns the
+    // fallback reason, or nullptr when the GPU can draw the primitive.
+    const char *gpuUnsupported(const GSPrimitiveBatch &batch)
+    {
+        const GSDrawState &state = batch.state;
+        const GSContext &ctx = state.context;
+        const bool sprite = state.prim.type == GS_PRIM_SPRITE && batch.vertexCount >= 2u;
+        const bool triangle = (state.prim.type == GS_PRIM_TRIANGLE || state.prim.type == GS_PRIM_TRISTRIP ||
+                               state.prim.type == GS_PRIM_TRIFAN) && batch.vertexCount >= 3u;
+        const uint8_t psm = ctx.frame.psm;
+        const uint64_t test = ctx.test;
+        if (!sprite && !triangle)
+            return "line/point";
+        if ((test & 0x4000u) != 0u && noFeedbackOpt())
+            return "dest-alpha-test";
+        if (psm != GS_PSM_CT32 && psm != GS_PSM_CT24 && psm != GS_PSM_CT16 && psm != GS_PSM_CT16S)
+            return "frame-psm";
+        if ((test & 0x10000u) != 0u)
+        {
+            const uint8_t zpsm = ctx.zbuf.psm;
+            if (zpsm != GS_PSM_Z32 && zpsm != GS_PSM_Z24 && zpsm != GS_PSM_Z16 && zpsm != GS_PSM_Z16S)
+                return "z-psm";
+            // Interpolated Z runs in fixed point on the GPU: integer Z in [0, 2^32), deltas below 2^28.
+            const GSVertex *v = batch.vertices.data();
+            for (int i = 0; i < (triangle ? 3 : 0); ++i)
+                if (!(v[i].z >= 0.0 && v[i].z < 4294967296.0 && v[i].z == std::floor(v[i].z) &&
+                      std::fabs(v[i].z - v[0].z) < 268435456.0))
+                    return "z-range";
+        }
+        if (state.prim.fge)
+            return "fog";
+        if (state.prim.tme)
+        {
+            switch (ctx.tex0.psm)
+            {
+            case 0x00: case 0x01: case 0x02: case 0x0A: case 0x13: case 0x14: case 0x1B: case 0x24: case 0x2C:
+            case 0x30: case 0x31: case 0x32: case 0x3A:
+                break;
+            default:
+                return "tex-psm";
+            }
+        }
+        return nullptr;
+    }
+}
+
+struct GSVulkanBackend::Impl
+{
+    VkShared &s;
+    VkBuffer vram = VK_NULL_HANDLE;
+    VkDeviceMemory vramMemory = VK_NULL_HANDLE;
+    void *mapped = nullptr;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    VkCommandPool commandPool = VK_NULL_HANDLE;
+    VkCommandBuffer cmd = VK_NULL_HANDLE; // cmds[cmdIndex]
+    VkCommandBuffer cmds[kMaxCmds]{};
+    VkFence fences[kMaxCmds]{};
+    uint32_t cmdIndex = 0, primsAtSubmit = 0;
+    // GOW-Port: GPU timestamps, only with PS2X_GS_VULKAN_STATS=1 (gpuTime false = no queries recorded, no overhead).
+    struct Dispatch { uint64_t unionPx, coveredPx; uint32_t prims; };
+    VkQueryPool queryPool = VK_NULL_HANDLE;
+    bool gpuTime = false;
+    uint32_t queriesUsed[kMaxCmds]{};
+    std::vector<Dispatch> dispatches[kMaxCmds];
+    VkBuffer prims = VK_NULL_HANDLE;
+    VkDeviceMemory primsMemory = VK_NULL_HANDLE;
+    PrimRecord *primsMapped = nullptr;
+    VkBuffer clut = VK_NULL_HANDLE;
+    VkDeviceMemory clutMemory = VK_NULL_HANDLE;
+    void *clutMapped = nullptr;
+    uint32_t primCount = 0;
+    bool open = false;
+    // Host-pointer import of the host VRAM array (no copies); else `vram`/`mapped` is a private copy.
+    VkBuffer importedVram = VK_NULL_HANDLE;
+    VkDeviceMemory importedMemory = VK_NULL_HANDLE;
+    const void *importedPtr = nullptr;
+    bool imported = false;
+    // The open batch: consecutive primitives with the same frame/Z targets whose texture reads and buffer
+    // writes don't touch each other's pages, so any workgroup order gives the same result.
+    uint32_t batchFirst = 0, batchCount = 0;
+    int batchRect[4] = {0, 0, 0, 0};
+    uint64_t batchPixels = 0;
+    uint32_t batchKey[3] = {0, 0, 0};
+    PageSet batchWrites, batchReads, batchFrames, batchDepths;
+    // GOW-Port: pages the whole run reads/writes (CPU transfers and CLUT loads that miss them need no fence), and
+    // the CLUT snapshots: one 512-entry slot per version, a primitive names its slot in tmode bits 25+.
+    PageSet runWrites, runReads;
+    uint32_t clutVersion = 0;
+    bool clutDirty = false;
+    bool transferSafe = false; // the transfer in progress did not end the run
+    bool dispatched = false;
+
+    // PS2X_GS_VULKAN_STATS=1: once per second, GPU vs CPU draws with fallback reasons and what ended GPU runs.
+    bool statsEnabled = [] { const char *v = std::getenv("PS2X_GS_VULKAN_STATS"); return v && *v && *v != '0'; }();
+    std::chrono::steady_clock::time_point statsStart = std::chrono::steady_clock::now();
+    uint64_t statsGpu = 0, statsCpu = 0, statsRuns = 0, statsBatches = 0, statsFinishUs = 0, statsRecordUs = 0, statsCpuUs = 0;
+    std::map<std::string, uint64_t> statsFallback, statsRunEnd, statsRunWaitUs;
+    // GOW-Port: GPU-side numbers. Bucket = union rectangle / sum of the primitives' own rectangles (<=2x, <=8x, <=32x, more).
+    double statsGpuBusyNs = 0, statsGpuSpanNs = 0;
+    uint64_t statsDispatches = 0, statsUnionPx = 0, statsCoveredPx = 0, statsWalkPx = 0, statsDispatchPrims = 0;
+    uint64_t statsBucketN[4]{}, statsBucketUnionPx[4]{}, statsBucketCoveredPx[4]{};
+    double statsBucketNs[4]{};
+
+    void statsTick()
+    {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - statsStart < std::chrono::seconds(1))
+            return;
+        std::string line, gpuLine;
+        for (const auto &[reason, count] : statsFallback)
+            line += " " + reason + "=" + std::to_string(count);
+        line += " | batches=" + std::to_string(statsBatches) + " finish_ms=" + std::to_string(statsFinishUs / 1000u) + " record_ms=" + std::to_string(statsRecordUs / 1000u) +
+                " cpudraw_ms=" + std::to_string(statsCpuUs / 1000u) +
+                " runs=" + std::to_string(statsRuns) + " ended by:";
+        for (const auto &[cause, count] : statsRunEnd)
+            line += " " + cause + "=" + std::to_string(count) + "(" + std::to_string(statsRunWaitUs[cause] / 1000u) + "ms)";
+        if (gpuTime)
+        {
+            char buf[512];
+            std::snprintf(buf, sizeof(buf),
+                          "\n[gow-gs-vk-gpu] gpu_busy_ms=%.1f (cmd span %.1f) dispatches=%llu avg_dispatch_ms=%.3f prims/dispatch=%.1f "
+                          "union_Mpx=%.1f covered_Mpx=%.1f (union/covered %.1fx) walk_Mpx=%.1f avg_union=%llu px",
+                          statsGpuBusyNs / 1e6, statsGpuSpanNs / 1e6, static_cast<unsigned long long>(statsDispatches),
+                          statsDispatches ? statsGpuBusyNs / 1e6 / static_cast<double>(statsDispatches) : 0.0,
+                          statsDispatches ? static_cast<double>(statsDispatchPrims) / static_cast<double>(statsDispatches) : 0.0,
+                          static_cast<double>(statsUnionPx) / 1e6, static_cast<double>(statsCoveredPx) / 1e6,
+                          statsCoveredPx ? static_cast<double>(statsUnionPx) / static_cast<double>(statsCoveredPx) : 0.0,
+                          static_cast<double>(statsWalkPx) / 1e6,
+                          static_cast<unsigned long long>(statsDispatches ? statsUnionPx / statsDispatches : 0));
+            gpuLine = buf;
+            static const char *names[4] = {"<=2x", "<=8x", "<=32x", ">32x"};
+            for (int b = 0; b < 4; ++b)
+            {
+                std::snprintf(buf, sizeof(buf), "%s n=%llu union_Mpx=%.1f gpu_ms=%.1f", names[b],
+                              static_cast<unsigned long long>(statsBucketN[b]), static_cast<double>(statsBucketUnionPx[b]) / 1e6,
+                              statsBucketNs[b] / 1e6);
+                gpuLine += std::string(b ? " | " : "\n[gow-gs-vk-gpu] union/covered: ") + buf;
+            }
+        }
+        std::fprintf(stderr, "[gow-gs-vk] gpu=%llu cpu=%llu:%s%s\n", static_cast<unsigned long long>(statsGpu),
+                     static_cast<unsigned long long>(statsCpu), line.c_str(), gpuLine.c_str());
+        statsStart = now;
+        statsGpu = statsCpu = statsRuns = statsBatches = statsFinishUs = statsRecordUs = statsCpuUs = 0;
+        statsFallback.clear();
+        statsRunEnd.clear();
+        statsRunWaitUs.clear();
+        statsGpuBusyNs = statsGpuSpanNs = 0;
+        statsDispatches = statsUnionPx = statsCoveredPx = statsWalkPx = statsDispatchPrims = 0;
+        std::fill(std::begin(statsBucketN), std::end(statsBucketN), 0);
+        std::fill(std::begin(statsBucketUnionPx), std::end(statsBucketUnionPx), 0);
+        std::fill(std::begin(statsBucketCoveredPx), std::end(statsBucketCoveredPx), 0);
+        std::fill(std::begin(statsBucketNs), std::end(statsBucketNs), 0.0);
+    }
+
+    // Reads the timestamps of the command buffers of a finished run (all fences signalled).
+    void collectGpuTime(uint32_t cmdCount)
+    {
+        const uint64_t mask = s.timestampBits >= 64 ? ~0ull : ((1ull << s.timestampBits) - 1ull);
+        std::vector<uint64_t> ts(kQueriesPerCmd);
+        for (uint32_t i = 0; i < cmdCount; ++i)
+        {
+            const uint32_t n = queriesUsed[i];
+            if (n < 2 || vkGetQueryPoolResults(s.device, queryPool, i * kQueriesPerCmd, n, n * sizeof(uint64_t), ts.data(),
+                                               sizeof(uint64_t), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) != VK_SUCCESS)
+                continue;
+            auto ns = [&](uint64_t a, uint64_t b) { return static_cast<double>((b - a) & mask) * static_cast<double>(s.timestampPeriod); };
+            statsGpuSpanNs += ns(ts[0], ts[1]);
+            for (size_t d = 0; d < dispatches[i].size() && 2 + 2 * d + 1 < n; ++d)
+            {
+                const Dispatch &disp = dispatches[i][d];
+                const double t = ns(ts[2 + 2 * d], ts[3 + 2 * d]);
+                statsGpuBusyNs += t;
+                const double ratio = disp.coveredPx ? static_cast<double>(disp.unionPx) / static_cast<double>(disp.coveredPx) : 1e9;
+                const int b = ratio <= 2.0 ? 0 : ratio <= 8.0 ? 1 : ratio <= 32.0 ? 2 : 3;
+                ++statsBucketN[b];
+                statsBucketUnionPx[b] += disp.unionPx;
+                statsBucketCoveredPx[b] += disp.coveredPx;
+                statsBucketNs[b] += t;
+            }
+        }
+    }
+
+    explicit Impl(VkShared &shared) : s(shared) {}
+
+    bool create()
+    {
+        void *primsVoid = nullptr;
+        if (!makeHostBuffer(s, GSSwizzle::kMemorySize, vram, vramMemory, &mapped) ||
+            !makeHostBuffer(s, kMaxPrims * sizeof(PrimRecord), prims, primsMemory, &primsVoid) ||
+            !makeHostBuffer(s, kClutVersions * 512u * sizeof(uint16_t), clut, clutMemory, &clutMapped))
+            return false;
+        primsMapped = static_cast<PrimRecord *>(primsVoid);
+        VkDescriptorPoolSize size{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 4};
+        VkDescriptorPoolCreateInfo poolInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+        poolInfo.maxSets = 1;
+        poolInfo.poolSizeCount = 1;
+        poolInfo.pPoolSizes = &size;
+        if (vkCreateDescriptorPool(s.device, &poolInfo, nullptr, &pool) != VK_SUCCESS)
+            return false;
+        VkDescriptorSetAllocateInfo setInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        setInfo.descriptorPool = pool;
+        setInfo.descriptorSetCount = 1;
+        setInfo.pSetLayouts = &s.setLayout;
+        if (vkAllocateDescriptorSets(s.device, &setInfo, &set) != VK_SUCCESS)
+            return false;
+        VkDescriptorBufferInfo buffers[4] = {{vram, 0, VK_WHOLE_SIZE}, {s.swizzle, 0, VK_WHOLE_SIZE},
+                                             {clut, 0, VK_WHOLE_SIZE}, {prims, 0, VK_WHOLE_SIZE}};
+        VkWriteDescriptorSet writes[4]{};
+        for (uint32_t i = 0; i < 4; ++i)
+        {
+            writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+            writes[i].dstSet = set;
+            writes[i].dstBinding = i;
+            writes[i].descriptorCount = 1;
+            writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+            writes[i].pBufferInfo = &buffers[i];
+        }
+        vkUpdateDescriptorSets(s.device, 4, writes, 0, nullptr);
+
+        VkCommandPoolCreateInfo poolCreate{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        poolCreate.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        poolCreate.queueFamilyIndex = s.family;
+        VkCommandBufferAllocateInfo cmdInfo{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        cmdInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        cmdInfo.commandBufferCount = kMaxCmds;
+        VkFenceCreateInfo fenceInfo{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        if (vkCreateCommandPool(s.device, &poolCreate, nullptr, &commandPool) != VK_SUCCESS)
+            return false;
+        cmdInfo.commandPool = commandPool;
+        if (vkAllocateCommandBuffers(s.device, &cmdInfo, cmds) != VK_SUCCESS)
+            return false;
+        cmd = cmds[0];
+        if (statsEnabled && s.timestampBits && s.timestampPeriod > 0.f)
+        {
+            VkQueryPoolCreateInfo q{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+            q.queryType = VK_QUERY_TYPE_TIMESTAMP;
+            q.queryCount = kQueriesPerCmd * kMaxCmds;
+            gpuTime = vkCreateQueryPool(s.device, &q, nullptr, &queryPool) == VK_SUCCESS;
+            std::fprintf(stderr, "[gow-gs-vk] GPU timestamps %s (valid bits %u, period %.2f ns)\n", gpuTime ? "on" : "unavailable",
+                         s.timestampBits, static_cast<double>(s.timestampPeriod));
+        }
+        for (VkFence &f : fences)
+            if (vkCreateFence(s.device, &fenceInfo, nullptr, &f) != VK_SUCCESS)
+                return false;
+        return true;
+    }
+
+    // Binds `buffer` as VRAM (binding 0). Nothing may be in flight.
+    void bindVram(VkBuffer buffer)
+    {
+        VkDescriptorBufferInfo info{buffer, 0, VK_WHOLE_SIZE};
+        VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+        write.dstSet = set;
+        write.dstBinding = 0;
+        write.descriptorCount = 1;
+        write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        write.pBufferInfo = &info;
+        vkUpdateDescriptorSets(s.device, 1, &write, 0, nullptr);
+    }
+
+    void dropImport()
+    {
+        if (importedVram)
+            vkDestroyBuffer(s.device, importedVram, nullptr);
+        if (importedMemory)
+            vkFreeMemory(s.device, importedMemory, nullptr);
+        importedVram = VK_NULL_HANDLE;
+        importedMemory = VK_NULL_HANDLE;
+        importedPtr = nullptr;
+        imported = false;
+    }
+
+    // Tries to make the host VRAM array itself the GPU buffer (page-aligned, host-coherent memory).
+    void importVram(void *ptr, size_t size)
+    {
+        if (imported && importedPtr == ptr)
+            return;
+        if (imported)
+        {
+            dropImport();
+            bindVram(vram);
+        }
+        const char *off = std::getenv("PS2X_VK_NO_IMPORT");
+        if (!s.getHostPointerProps || (off && *off && *off != '0') || size < GSSwizzle::kMemorySize ||
+            reinterpret_cast<uintptr_t>(ptr) % 4096u != 0u)
+            return;
+        VkExternalMemoryBufferCreateInfo external{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO};
+        external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+        VkBufferCreateInfo info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+        info.pNext = &external;
+        info.size = GSSwizzle::kMemorySize;
+        info.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+        VkMemoryHostPointerPropertiesEXT props{VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT};
+        VkMemoryRequirements req{};
+        uint32_t type = UINT32_MAX;
+        const VkMemoryPropertyFlags coherent = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+        if (s.getHostPointerProps(s.device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, ptr, &props) == VK_SUCCESS &&
+            vkCreateBuffer(s.device, &info, nullptr, &importedVram) == VK_SUCCESS)
+        {
+            vkGetBufferMemoryRequirements(s.device, importedVram, &req);
+            for (uint32_t i = 0; i < s.memory.memoryTypeCount && type == UINT32_MAX; ++i)
+                if ((req.memoryTypeBits & props.memoryTypeBits & (1u << i)) &&
+                    (s.memory.memoryTypes[i].propertyFlags & coherent) == coherent)
+                    type = i;
+        }
+        if (type != UINT32_MAX)
+        {
+            VkImportMemoryHostPointerInfoEXT import{VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT};
+            import.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+            import.pHostPointer = ptr;
+            VkMemoryAllocateInfo alloc{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+            alloc.pNext = &import;
+            alloc.allocationSize = (req.size + 4095u) & ~VkDeviceSize(4095);
+            alloc.memoryTypeIndex = type;
+            if (alloc.allocationSize <= size && vkAllocateMemory(s.device, &alloc, nullptr, &importedMemory) == VK_SUCCESS &&
+                vkBindBufferMemory(s.device, importedVram, importedMemory, 0) == VK_SUCCESS)
+            {
+                imported = true;
+                importedPtr = ptr;
+                bindVram(importedVram);
+                std::fprintf(stderr, "[gow-gs] Vulkan: host VRAM imported (zero-copy)\n");
+                return;
+            }
+        }
+        dropImport();
+    }
+
+    ~Impl()
+    {
+        dropImport();
+        for (VkFence f : fences)
+            if (f)
+                vkDestroyFence(s.device, f, nullptr);
+        if (queryPool)
+            vkDestroyQueryPool(s.device, queryPool, nullptr);
+        if (commandPool)
+            vkDestroyCommandPool(s.device, commandPool, nullptr);
+        if (pool)
+            vkDestroyDescriptorPool(s.device, pool, nullptr);
+        if (vram)
+            vkDestroyBuffer(s.device, vram, nullptr);
+        if (vramMemory)
+            vkFreeMemory(s.device, vramMemory, nullptr);
+        for (VkBuffer buffer : {prims, clut})
+            if (buffer)
+                vkDestroyBuffer(s.device, buffer, nullptr);
+        for (VkDeviceMemory memory : {primsMemory, clutMemory})
+            if (memory)
+                vkFreeMemory(s.device, memory, nullptr);
+    }
+
+    void beginCmd()
+    {
+        VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        vkBeginCommandBuffer(cmd, &begin);
+        vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s.pipeline);
+        vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s.pipelineLayout, 0, 1, &set, 0, nullptr);
+        if (gpuTime)
+        {
+            vkCmdResetQueryPool(cmd, queryPool, cmdIndex * kQueriesPerCmd, kQueriesPerCmd);
+            vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, queryPool, cmdIndex * kQueriesPerCmd);
+            queriesUsed[cmdIndex] = 2; // slot 1 (end) is written by submitCmd
+            dispatches[cmdIndex].clear();
+        }
+    }
+
+    void submitCmd()
+    {
+        if (gpuTime)
+            vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, queryPool, cmdIndex * kQueriesPerCmd + 1);
+        vkEndCommandBuffer(cmd);
+        VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        submit.commandBufferCount = 1;
+        submit.pCommandBuffers = &cmd;
+        std::lock_guard<std::mutex> queueLock(s.queueMutex);
+        vkQueueSubmit(s.queue, 1, &submit, fences[cmdIndex]);
+    }
+
+    // Starts the GPU on what is recorded so far, without waiting: it overlaps with the emulation until the
+    // next CPU access to VRAM. The barrier of the next dispatch orders it after the submitted work.
+    void submitPartial()
+    {
+        if (cmdIndex + 1 >= kMaxCmds)
+            return;
+        emitBatch();
+        submitCmd();
+        cmd = cmds[++cmdIndex];
+        beginCmd();
+        primsAtSubmit = primCount;
+    }
+
+    // Records the open batch as one dispatch over its union rectangle.
+    void emitBatch()
+    {
+        if (!batchCount)
+            return;
+        // GOW-Port: the pair brackets barrier + dispatch, so the intervals tile the GPU's busy time.
+        const bool timed = gpuTime && queriesUsed[cmdIndex] + 2 <= kQueriesPerCmd;
+        if (timed)
+            vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, queryPool, cmdIndex * kQueriesPerCmd + queriesUsed[cmdIndex]);
+        if (dispatched)
+            memoryBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+        const Push push{batchRect[0], batchRect[1], batchFirst, batchCount};
+        vkCmdPushConstants(cmd, s.pipelineLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), &push);
+        vkCmdDispatch(cmd, static_cast<uint32_t>(batchRect[2] - batchRect[0]) / 8u + 1u,
+                      static_cast<uint32_t>(batchRect[3] - batchRect[1]) / 8u + 1u, 1u);
+        dispatched = true;
+        ++statsBatches;
+        if (timed)
+        {
+            vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, queryPool, cmdIndex * kQueriesPerCmd + queriesUsed[cmdIndex] + 1);
+            queriesUsed[cmdIndex] += 2;
+            const uint64_t u = static_cast<uint64_t>(batchRect[2] - batchRect[0] + 1) * static_cast<uint64_t>(batchRect[3] - batchRect[1] + 1);
+            dispatches[cmdIndex].push_back({u, batchPixels, batchCount});
+            ++statsDispatches;
+            statsUnionPx += u;
+            statsCoveredPx += batchPixels;
+            statsWalkPx += u * batchCount;
+            statsDispatchPrims += batchCount;
+        }
+        batchCount = 0;
+    }
+
+    // True if `rec` (touching `reads`/`writes` pages) can join the open batch.
+    bool canJoin(const PrimRecord &rec, const uint32_t key[3], const PageSet &reads, const PageSet &writes,
+                 const PageSet &frames, const PageSet &depths) const
+    {
+        if (!batchCount || batchCount >= kMaxBatch || std::memcmp(key, batchKey, sizeof(batchKey)) != 0)
+            return false;
+        if ((reads & batchWrites).any() || (writes & batchReads).any() || (frames & batchDepths).any() ||
+            (depths & batchFrames).any())
+            return false;
+        // Every thread of the union rectangle walks the whole batch: keep that near the useful work.
+        const int x0 = std::min(batchRect[0], rec.rect[0]), y0 = std::min(batchRect[1], rec.rect[1]);
+        const int x1 = std::max(batchRect[2], rec.rect[2]), y1 = std::max(batchRect[3], rec.rect[3]);
+        const uint64_t unionPixels = static_cast<uint64_t>(x1 - x0 + 1) * static_cast<uint64_t>(y1 - y0 + 1);
+        const uint64_t sum = batchPixels + static_cast<uint64_t>(rec.rect[2] - rec.rect[0] + 1) * (rec.rect[3] - rec.rect[1] + 1);
+        return (batchCount + 1u) * unionPixels <= 64u * sum + 1048576u;
+    }
+
+    void memoryBarrier(VkPipelineStageFlags dstStage, VkAccessFlags dstAccess)
+    {
+        VkMemoryBarrier barrier{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+        barrier.dstAccessMask = dstAccess;
+        vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, dstStage, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+    }
+};
+
+GSVulkanBackend::GSVulkanBackend()
+{
+    if (VkShared *s = shared())
+    {
+        m_impl = std::make_unique<Impl>(*s);
+        if (!m_impl->create())
+        {
+            std::fprintf(stderr, "[gow-gs] Vulkan GS resources could not be created\n");
+            m_impl.reset();
+        }
+    }
+}
+
+GSVulkanBackend::~GSVulkanBackend()
+{
+    Finish();
+}
+
+bool GSVulkanBackend::IsReady() const
+{
+    return m_impl != nullptr;
+}
+
+void GSVulkanBackend::Finish(const char *cause) const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (!m_impl || !m_impl->open)
+        return;
+    Impl &impl = *m_impl;
+    if (impl.statsEnabled)
+    {
+        ++impl.statsRuns;
+        ++impl.statsRunEnd[cause];
+    }
+    impl.emitBatch();
+    impl.memoryBarrier(VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_HOST_READ_BIT);
+    impl.submitCmd();
+    const auto waitStart = std::chrono::steady_clock::now();
+    vkWaitForFences(impl.s.device, impl.cmdIndex + 1, impl.fences, VK_TRUE, UINT64_MAX);
+    vkResetFences(impl.s.device, impl.cmdIndex + 1, impl.fences);
+    if (impl.gpuTime)
+        impl.collectGpuTime(impl.cmdIndex + 1);
+    for (uint32_t i = 0; i <= impl.cmdIndex; ++i)
+        vkResetCommandBuffer(impl.cmds[i], 0);
+    impl.open = false;
+    if (!impl.imported)
+        std::memcpy(m_vram, impl.mapped, std::min<size_t>(m_vramSize, GSSwizzle::kMemorySize));
+    const uint64_t waitUs = static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - waitStart).count());
+    impl.statsFinishUs += waitUs;
+    if (impl.statsEnabled)
+        impl.statsRunWaitUs[cause] += waitUs; // GOW-Port: wait per run-ending cause
+}
+
+const char *GSVulkanBackend::RecordGpu(const GSPrimitiveBatch &batch)
+{
+    if (!m_impl || !m_vram || m_vramSize < GSSwizzle::kMemorySize)
+        return "no-gpu";
+    if (const char *reason = gpuUnsupported(batch))
+        return reason;
+    const GSDrawState &state = batch.state;
+    const GSContext &ctx = state.context;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const float texW = static_cast<float>(state.textureWidth);
+    const float texH = static_cast<float>(state.textureHeight);
+
+    // Same float rounding as GSCpuBackend::Submit (GSCpuRoundingScope).
+    const unsigned csr = _mm_getcsr();
+    _mm_setcsr(csr & ~_MM_ROUND_MASK);
+    PrimRecord rec{};
+    int x0, y0, x1, y1;
+    bool empty = false;
+    int64_t triXY[6] = {};
+    if (state.prim.type == GS_PRIM_SPRITE)
+    {
+        const GSSpriteAxis axisX = gsSpriteAxis(v0.x, v1.x, static_cast<float>(ctx.xyoffset.ofx) / 16.0f);
+        const GSSpriteAxis axisY = gsSpriteAxis(v0.y, v1.y, static_cast<float>(ctx.xyoffset.ofy) / 16.0f);
+        x0 = std::max(axisX.first, static_cast<int>(ctx.scissor.x0));
+        y0 = std::max(axisY.first, static_cast<int>(ctx.scissor.y0));
+        x1 = std::min(axisX.last, static_cast<int>(ctx.scissor.x1));
+        y1 = std::min(axisY.last, static_cast<int>(ctx.scissor.y1));
+        rec.color[0] = packColor(v1);
+        rec.axis[0] = axisX.origin;
+        rec.axis[1] = axisX.scale;
+        rec.axis[2] = axisY.origin;
+        rec.axis[3] = axisY.scale;
+        // Per-vertex texel coordinates exactly as GSCpuBackend::DrawSprite computes them.
+        if (state.prim.fst)
+        {
+            rec.attr[0] = static_cast<float>(v0.u) / 16.0f;
+            rec.attr[1] = static_cast<float>(v0.v) / 16.0f;
+            rec.attr[2] = static_cast<float>(v1.u) / 16.0f;
+            rec.attr[3] = static_cast<float>(v1.v) / 16.0f;
+        }
+        else
+        {
+            const float q0 = fabsQ(v0.q);
+            const float q1 = fabsQ(v1.q);
+            rec.attr[0] = (v0.s / q0) * texW;
+            rec.attr[1] = (v0.t / q0) * texH;
+            rec.attr[2] = (v1.s / q1) * texW;
+            rec.attr[3] = (v1.t / q1) * texH;
+        }
+    }
+    else
+    {
+        GSTriangleRaster t;
+        empty = !gsTriangleSetup(v0.x, v0.y, v1.x, v1.y, v2.x, v2.y, ctx.xyoffset.ofx, ctx.xyoffset.ofy, t);
+        x0 = std::max(t.minX, static_cast<int>(ctx.scissor.x0));
+        y0 = std::max(t.minY, static_cast<int>(ctx.scissor.y0));
+        x1 = std::min(t.maxX, static_cast<int>(ctx.scissor.x1));
+        y1 = std::min(t.maxY, static_cast<int>(ctx.scissor.y1));
+        for (int i = 0; i < 3; ++i)
+        {
+            rec.ea[i] = t.a[i];
+            rec.eb[i] = t.b[i];
+            rec.ec[i] = t.c[i];
+            rec.mode |= t.bias[i] ? (kBias0 << i) : 0u;
+            const GSVertex &v = batch.vertices[i];
+            if (state.prim.fst)
+            {
+                rec.attr[i * 2] = static_cast<float>(v.u);
+                rec.attr[i * 2 + 1] = static_cast<float>(v.v);
+            }
+            else
+            {
+                rec.attr[i * 3] = v.s;
+                rec.attr[i * 3 + 1] = v.t;
+                rec.attr[i * 3 + 2] = v.q;
+            }
+        }
+        for (int i = 0; i < 3; ++i)
+        {
+            triXY[i * 2] = t.x[i];
+            triXY[i * 2 + 1] = t.y[i];
+        }
+        rec.area = t.area;
+        rec.mode |= kTriangle;
+        if (state.prim.iip)
+        {
+            rec.mode |= kIip;
+            rec.color[0] = packColor(v0);
+            rec.color[1] = packColor(v1);
+            rec.color[2] = packColor(v2);
+        }
+        else
+            rec.color[0] = packColor(v2);
+    }
+    _mm_setcsr(csr);
+    if (empty || x0 > x1 || y0 > y1)
+        return nullptr; // the CPU backend draws nothing either
+
+    rec.rect[0] = x0;
+    rec.rect[1] = y0;
+    rec.rect[2] = x1;
+    rec.rect[3] = y1;
+    rec.frame = GSInternal::framePageBaseToBlock(ctx.frame.fbp) | (std::max<uint32_t>(ctx.frame.fbw, 1u) << 16u);
+    rec.mode |= ctx.frame.psm | ((ctx.fba & 1u) ? kFba : 0u);
+    rec.fbmsk = ctx.frame.fbmsk;
+    rec.test = static_cast<uint32_t>(ctx.test & 0xFFFFu); // GOW-Port: includes DATE/DATM (bits 14-15)
+    // Z as DrawSprite (u32(v1.z)) and DrawTriangle (v0.z plus the interpolated deltas) pass it on.
+    if (state.prim.type == GS_PRIM_SPRITE)
+        rec.z = static_cast<uint32_t>(v1.z);
+    else if ((ctx.test & 0x10000u) != 0u)
+    {
+        rec.z = static_cast<uint32_t>(v0.z);
+        rec.zd[0] = static_cast<int32_t>(v1.z - v0.z);
+        rec.zd[1] = static_cast<int32_t>(v2.z - v0.z);
+        rec.mode |= kZip;
+    }
+    {
+        const bool zte = (ctx.test & 0x10000u) != 0u;
+        const uint32_t ztst = zte ? static_cast<uint32_t>((ctx.test >> 17) & 3u) : 1u;
+        rec.zbuf = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp) | (static_cast<uint32_t>(ctx.zbuf.psm) << 16u) |
+                   (ztst << 24u) | ((zte && !ctx.zbuf.zmask) ? 0x4000000u : 0u);
+    }
+    if (state.prim.abe)
+        rec.alpha = static_cast<uint32_t>(ctx.alpha & 0xFFu) | (static_cast<uint32_t>((ctx.alpha >> 32) & 0xFFu) << 8u) | kAbe |
+                    (state.pabe ? kPabe : 0u) | ((state.colclamp & 1u) ? kColclamp : 0u);
+    if (state.prim.tme)
+    {
+        const GSTex0Reg &tex = ctx.tex0;
+        rec.mode |= kTme | (state.prim.fst ? kFst : 0u) | (state.linearFilter ? kLinear : 0u);
+        rec.tex = (tex.tbp0 & 0x3FFFu) | (static_cast<uint32_t>(tex.tbw) << 16u) | (static_cast<uint32_t>(tex.psm) << 24u);
+        rec.tsize = state.textureWidth | (static_cast<uint32_t>(state.textureHeight) << 16u);
+        rec.tmode = tex.tcc | (static_cast<uint32_t>(tex.tfx) << 8u) | (static_cast<uint32_t>(tex.cpsm) << 16u) |
+                    (static_cast<uint32_t>(tex.csm) << 24u);
+        rec.texa = (tex.csa & 0x1Fu) | (static_cast<uint32_t>(state.texa.ta0) << 8u) |
+                   (state.texa.aem ? 0x10000u : 0u) | (static_cast<uint32_t>(state.texa.ta1) << 24u);
+        rec.clampLo = static_cast<uint32_t>(ctx.clamp);
+        rec.clampHi = static_cast<uint32_t>(ctx.clamp >> 32u);
+    }
+
+    // Pages this primitive reads (texture) and writes (frame, and Z when written): a primitive that reads what it
+    // writes needs the CPU's row order; batch-mates must not read what an earlier one wrote, or the reverse.
+    // Frame and Z pages are tracked apart: a frame that overlaps Z memory is owned by other threads (pixel
+    // positions differ), which is only safe in the CPU's row order.
+    PageSet reads, writes, frames, depths;
+    bufferPages(frames, GSInternal::framePageBaseToBlock(ctx.frame.fbp) >> 5, ctx.frame.fbw, ctx.frame.psm, x0, y0, x1, y1);
+    if (((rec.zbuf >> 24) & 3u) >= 2u || (rec.zbuf & 0x4000000u))
+        bufferPages(depths, GSInternal::framePageBaseToBlock(ctx.zbuf.zbp) >> 5, ctx.frame.fbw, ctx.zbuf.psm, x0, y0, x1, y1);
+
+    auto fbDiag = [&](const char *why) {
+        static const bool on = std::getenv("GOW_VK_FBDIAG") != nullptr;
+        if (!on) return;
+        static std::map<std::string, int> seen;
+        char b[400];
+        std::snprintf(b, sizeof b, "%s %s frame=%x/%u/%x z=%x/%x zw=%u tex=%x/%u/%x tme=%d lin=%d clamp=%llx rect=%d,%d,%d,%d uv=%g,%g,%g,%g tw=%d th=%d",
+                      why, state.prim.type == GS_PRIM_SPRITE ? "spr" : "tri", ctx.frame.fbp, ctx.frame.fbw, ctx.frame.psm, ctx.zbuf.zbp, ctx.zbuf.psm,
+                      (rec.zbuf & 0x4000000u) ? 1 : 0, ctx.tex0.tbp0, ctx.tex0.tbw, ctx.tex0.psm, state.prim.tme, state.linearFilter ? 1 : 0,
+                      (unsigned long long)ctx.clamp, x0, y0, x1, y1, rec.attr[0], rec.attr[1], rec.attr[2], rec.attr[3], state.textureWidth, state.textureHeight);
+        std::string k(b);
+        if (++seen[k] == 1 && seen.size() < 80) std::fprintf(stderr, "[fbdiag] %s\n", b);
+    };
+    bool aliasing = false;
+    if ((frames & depths).any())
+    {
+        // GOW-Port: frame and Z pages overlap. Safe on the GPU when no word is shared between two different pixels (see
+        // frameZAliasSafe); texture reads of those pages stay on the CPU (below).
+        static const bool noZAlias = std::getenv("GOW_VK_NO_ZALIAS") != nullptr; // A/B switch
+        if (noFeedbackOpt() || noZAlias || !frameZAliasSafe(GSInternal::framePageBaseToBlock(ctx.frame.fbp), GSInternal::framePageBaseToBlock(ctx.zbuf.zbp),
+                                                ctx.frame.fbw, ctx.frame.psm, ctx.zbuf.psm, x0, y0, x1, y1))
+        {
+            fbDiag("z-alias");
+            return "z-alias";
+        }
+        aliasing = true;
+    }
+    writes = frames | depths;
+    const PageSet texHazard = ((rec.zbuf & 0x4000000u) || noFeedbackOpt() ? writes : frames); // Z pages that are only tested are read-only
+    if (state.prim.tme)
+    {
+        // GOW-Port: a sprite with CLAMP/non-wrapping sampling reads only its UV box (+1 texel for bilinear).
+        uint32_t bb[4] = {};
+        bool boxed = false;
+        if (state.prim.type == GS_PRIM_SPRITE && (ctx.clamp & 0xFu) <= 5u && (ctx.clamp & 3u) <= 1u && ((ctx.clamp >> 2) & 3u) <= 1u)
+        {
+            // Texel interval a sprite samples per axis: u runs from the first vertex value to the second but never
+            // reaches the second one (the last pixel is one step short); +-1/32 covers the 12.4 re-quantisation.
+            // Bilinear reads floor(u - 0.5) and the next texel.
+            float lo[2], hi[2];
+            for (int i = 0; i < 2; ++i)
+            {
+                const float p = rec.attr[i], q = rec.attr[i + 2], scale = rec.axis[i * 2 + 1];
+                const float d = (q - p) * std::fabs(scale); // one step short of the far vertex
+                const bool forward = scale >= 0.0f;
+                const float e0 = forward ? p : p + d, e1 = forward ? q - d : q; // only the shortened end gets slack
+                const float s0 = forward ? 0.0f : 0.03125f, s1 = forward ? 0.03125f : 0.0f;
+                lo[i] = e0 <= e1 ? e0 - s0 : e1 - s1;
+                hi[i] = e0 <= e1 ? e1 + s1 : e0 + s0;
+                if (state.linearFilter)
+                {
+                    lo[i] = std::floor(lo[i] - 0.5f);
+                    hi[i] = std::floor(hi[i] - 0.5f) + 1.0f;
+                }
+                else
+                {
+                    lo[i] = std::floor(lo[i]);
+                    hi[i] = std::floor(hi[i]);
+                }
+            }
+            const float tw = static_cast<float>(state.textureWidth), th = static_cast<float>(state.textureHeight);
+            const bool clampS = (ctx.clamp & 3u) == 1u, clampT = ((ctx.clamp >> 2) & 3u) == 1u;
+            if ((clampS || (lo[0] >= 0.0f && hi[0] < tw)) && (clampT || (lo[1] >= 0.0f && hi[1] < th)) &&
+                std::isfinite(lo[0] + lo[1] + hi[0] + hi[1]))
+            {
+                bb[0] = static_cast<uint32_t>(std::clamp(lo[0], 0.0f, tw - 1.0f));
+                bb[1] = static_cast<uint32_t>(std::clamp(lo[1], 0.0f, th - 1.0f));
+                bb[2] = static_cast<uint32_t>(std::clamp(hi[0], 0.0f, tw - 1.0f));
+                bb[3] = static_cast<uint32_t>(std::clamp(hi[1], 0.0f, th - 1.0f));
+                boxed = true;
+            }
+        }
+        bool selfDisjoint = false;
+        texturePages(reads, state, boxed ? bb : nullptr);
+        if (noFeedbackOpt() || aliasing)
+            ;
+        else if (state.prim.type == GS_PRIM_SPRITE && spriteReadsOwnPixel(state, rec.axis, rec.attr, x0, y0, x1, y1))
+            reads.reset(); // GOW-Port: reads only its own pixel (see spriteReadsOwnPixel)
+        else if (state.prim.type != GS_PRIM_SPRITE && triangleReadsOwnPixel(state, batch.vertices.data(), triXY, x0, y0, x1, y1))
+            reads.reset();
+        // GOW-Port: texels of the same buffer that lie outside the written rectangle (e.g. 8-px channel-shuffle strips
+        // reading the neighbouring columns) cannot be touched by any thread of this primitive. Batch-mates still see
+        // the page sets, so the next primitive starts a new batch.
+        else if (boxed && sameBuffer(state, ctx) && (bb[2] < static_cast<uint32_t>(x0) || bb[0] > static_cast<uint32_t>(x1) ||
+                                                    bb[3] < static_cast<uint32_t>(y0) || bb[1] > static_cast<uint32_t>(y1)))
+            selfDisjoint = true;
+        if ((reads & (selfDisjoint ? (texHazard & ~frames) : texHazard)).any())
+        {
+            fbDiag("tex-fb");
+            return "tex-feedback";
+        }
+    }
+    const uint32_t key[3] = {rec.frame, rec.mode & 0xFFu, rec.zbuf & 0x00FFFFFFu};
+
+    Impl &impl = *m_impl;
+    const bool indexedTex = state.prim.tme && (ctx.tex0.psm == GS_PSM_T8 || ctx.tex0.psm == GS_PSM_T8H ||
+                                               ctx.tex0.psm == GS_PSM_T4 || ctx.tex0.psm == GS_PSM_T4HL ||
+                                               ctx.tex0.psm == GS_PSM_T4HH);
+    if (impl.open && impl.primCount == kMaxPrims)
+        Finish("record-ring");
+    if (impl.open && indexedTex && impl.clutDirty && impl.clutVersion + 1u >= kClutVersions)
+        Finish("clut-ring");
+    if (!impl.open)
+    {
+        if (!impl.imported)
+            std::memcpy(impl.mapped, m_vram, GSSwizzle::kMemorySize);
+        std::memcpy(impl.clutMapped, m_cpu.m_clut.data(), 512u * sizeof(uint16_t));
+        impl.clutVersion = 0;
+        impl.clutDirty = false;
+        impl.runReads.reset();
+        impl.runWrites.reset();
+        impl.primCount = 0;
+        impl.batchCount = 0;
+        impl.dispatched = false;
+        impl.cmdIndex = 0;
+        impl.primsAtSubmit = 0;
+        impl.cmd = impl.cmds[0];
+        impl.beginCmd();
+        impl.open = true;
+    }
+    if (indexedTex)
+    {
+        if (impl.clutDirty)
+        {
+            ++impl.clutVersion;
+            impl.clutDirty = false;
+            std::memcpy(static_cast<uint16_t *>(impl.clutMapped) + impl.clutVersion * 512u, m_cpu.m_clut.data(),
+                        512u * sizeof(uint16_t));
+        }
+        rec.tmode |= impl.clutVersion << 25u;
+    }
+    impl.runReads |= reads;
+    impl.runWrites |= writes;
+    if (!impl.canJoin(rec, key, reads, writes, frames, depths))
+    {
+        if (impl.primCount - impl.primsAtSubmit >= kSubmitEvery)
+            impl.submitPartial();
+        else
+            impl.emitBatch(); // a barrier then separates it from the next one
+        impl.batchFirst = impl.primCount;
+        std::memcpy(impl.batchKey, key, sizeof(key));
+        impl.batchRect[0] = rec.rect[0];
+        impl.batchRect[1] = rec.rect[1];
+        impl.batchRect[2] = rec.rect[2];
+        impl.batchRect[3] = rec.rect[3];
+        impl.batchPixels = 0;
+        impl.batchWrites.reset();
+        impl.batchReads.reset();
+        impl.batchFrames.reset();
+        impl.batchDepths.reset();
+    }
+    impl.batchRect[0] = std::min(impl.batchRect[0], rec.rect[0]);
+    impl.batchRect[1] = std::min(impl.batchRect[1], rec.rect[1]);
+    impl.batchRect[2] = std::max(impl.batchRect[2], rec.rect[2]);
+    impl.batchRect[3] = std::max(impl.batchRect[3], rec.rect[3]);
+    impl.batchPixels += static_cast<uint64_t>(rec.rect[2] - rec.rect[0] + 1) * (rec.rect[3] - rec.rect[1] + 1);
+    impl.batchWrites |= writes;
+    impl.batchReads |= reads;
+    impl.batchFrames |= frames;
+    impl.batchDepths |= depths;
+    impl.primsMapped[impl.primCount++] = rec;
+    ++impl.batchCount;
+    ++m_gpuPrimitives;
+    return nullptr;
+}
+
+void GSVulkanBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    Finish();
+    m_vram = vram;
+    m_vramSize = vramSize;
+    if (m_impl)
+        m_impl->importVram(vram, vramSize);
+    m_cpu.Initialize(vram, vramSize);
+}
+
+void GSVulkanBackend::Reset()
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    Finish();
+    m_cpu.Reset();
+}
+
+void GSVulkanBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    const auto t0 = std::chrono::steady_clock::now();
+    const char *reason = RecordGpu(batch);
+    if (m_impl && m_impl->statsEnabled)
+    {
+        m_impl->statsRecordUs += static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
+        if (reason)
+        {
+            ++m_impl->statsCpu;
+            ++m_impl->statsFallback[reason];
+        }
+        else
+            ++m_impl->statsGpu;
+        m_impl->statsTick();
+    }
+    if (!reason)
+        return;
+    Finish(reason);
+    const auto t1 = std::chrono::steady_clock::now();
+    m_cpu.Submit(batch);
+    if (m_impl && m_impl->statsEnabled)
+        m_impl->statsCpuUs += static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t1).count());
+}
+
+// Everything below is CPU work on host VRAM, after the GPU run (if any) has landed there.
+#define GOW_VK_CPU(call)                                \
+    std::lock_guard<std::recursive_mutex> lock(m_mutex); \
+    Finish(#call);                                      \
+    return m_cpu.call
+
+void GSVulkanBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    // Same early-outs as GSCpuBackend::LoadClut: when no CLUT is loaded, VRAM is not read and the run goes on.
+    const bool indexed = tex0.psm == GS_PSM_T8 || tex0.psm == GS_PSM_T8H || tex0.psm == GS_PSM_T4 ||
+                         tex0.psm == GS_PSM_T4HL || tex0.psm == GS_PSM_T4HH;
+    const bool loads = indexed && tex0.cld >= 1u && tex0.cld <= 5u &&
+                       !(tex0.cld == 4u && m_cpu.m_clutCbp[0] == tex0.cbp) &&
+                       !(tex0.cld == 5u && m_cpu.m_clutCbp[1] == tex0.cbp);
+    if (loads && m_impl && m_impl->open)
+    {
+        // GOW-Port: a CSM1 load reads at most 16 blocks at CBP; it needs the fence only if the run writes them.
+        // The next indexed primitive records a fresh CLUT snapshot.
+        const bool csm1 = tex0.csm == 0u;
+        if (!csm1 || m_impl->runWrites.test((tex0.cbp >> 5) & 511u) || m_impl->runWrites.test(((tex0.cbp + 15u) >> 5) & 511u))
+            Finish("LoadClut");
+    }
+    m_cpu.LoadClut(tex0, texclut);
+    if (loads && m_impl)
+        m_impl->clutDirty = true;
+}
+// GOW-Port: a transfer whose pages the run neither reads nor writes (zero-copy only, so Finish cannot overwrite the
+// upload with stale GPU-side VRAM) proceeds on the CPU while the GPU run goes on.
+void GSVulkanBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    bool safe = false;
+    if (m_impl && m_impl->open && m_impl->imported && command.direction <= 2u)
+    {
+        Impl &impl = *m_impl;
+        const GSBitBltBuf &b = command.bitbltbuf;
+        auto pages = [&](PageSet &out, uint32_t bp, uint32_t bw, uint32_t psm, uint32_t x, uint32_t y) {
+            uint32_t pw, ph;
+            pageSize(psm, pw, ph);
+            const uint32_t perRow = std::max(1u, (std::max(bw, 1u) * 64u) / pw);
+            const uint32_t w = std::max<uint32_t>(command.trxreg.rrw, 1u), h = std::max<uint32_t>(command.trxreg.rrh, 1u);
+            // one page of slack on each axis for block-unaligned bases
+            for (uint32_t py = y / ph; py <= (y + h - 1u) / ph + 1u; ++py)
+                for (uint32_t px = x / pw; px <= (x + w - 1u) / pw + 1u; ++px)
+                    out.set(((bp >> 5) + py * perRow + px) & 511u);
+        };
+        PageSet src, dst;
+        if (command.direction != 0u)
+            pages(src, b.sbp, b.sbw, b.spsm, command.trxpos.ssax, command.trxpos.ssay);
+        if (command.direction != 1u)
+            pages(dst, b.dbp, b.dbw, b.dpsm, command.trxpos.dsax, command.trxpos.dsay);
+        safe = !(src & impl.runWrites).any() && !(dst & (impl.runWrites | impl.runReads)).any();
+    }
+    if (!safe)
+        Finish("BeginTransfer(command)");
+    if (m_impl)
+        m_impl->transferSafe = safe;
+    m_cpu.BeginTransfer(command);
+}
+void GSVulkanBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    if (!m_impl || !m_impl->transferSafe)
+        Finish("UploadImage(data, sizeBytes)");
+    m_cpu.UploadImage(data, sizeBytes);
+}
+void GSVulkanBackend::Flush() { GOW_VK_CPU(Flush()); }
+// Only drops the CPU texture page cache: no VRAM access, so the GPU run goes on.
+void GSVulkanBackend::TextureFlush()
+{
+    std::lock_guard<std::recursive_mutex> lock(m_mutex);
+    m_cpu.TextureFlush();
+}
+void GSVulkanBackend::Sync(GSSyncReason reason) { GOW_VK_CPU(Sync(reason)); }
+PresentationFrame GSVulkanBackend::Present(const GSPresentationRequest &request) { GOW_VK_CPU(Present(request)); }
+bool GSVulkanBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba) { GOW_VK_CPU(ClearFramebuffer(context, rgba)); }
+uint32_t GSVulkanBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) { GOW_VK_CPU(ConsumeLocalToHostBytes(dst, maxBytes)); }
+uint32_t GSVulkanBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const { GOW_VK_CPU(ReadVram(psm, base, bw, x, y)); }
+void GSVulkanBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) { GOW_VK_CPU(WriteVram(psm, base, bw, x, y, value)); }
+void GSVulkanBackend::SnapshotVram(std::vector<uint8_t> &out) const { GOW_VK_CPU(SnapshotVram(out)); }
+GSTransferSnapshot GSVulkanBackend::GetTransferSnapshot() const { GOW_VK_CPU(GetTransferSnapshot()); }
+bool GSVulkanBackend::ExportState(GSBackendState &out) { GOW_VK_CPU(ExportState(out)); }
+bool GSVulkanBackend::ImportState(const GSBackendState &state) { GOW_VK_CPU(ImportState(state)); }
+
+#undef GOW_VK_CPU
