diff --git a/ps2xRuntime/include/runtime/display_options.h b/ps2xRuntime/include/runtime/display_options.h
new file mode 100644
index 0000000..f9f9ad4
--- /dev/null
+++ b/ps2xRuntime/include/runtime/display_options.h
@@ -0,0 +1,31 @@
+// GOW-Port: host display options (GOW_FULLSCREEN, GOW_SCALE_FILTER, GOW_WINDOW_SCALE). Header-only, no raylib.
+#pragma once
+#include <cstdlib>
+#include <cstring>
+#include <strings.h>
+
+namespace ps2x
+{
+enum class ScaleFilter { Bilinear, SharpBilinear, Nearest };
+
+// Unknown or empty values fall back to bilinear (the runtime's historical behaviour).
+inline ScaleFilter ParseScaleFilter(const char *v)
+{
+    if (!v)
+        return ScaleFilter::Bilinear;
+    if (!strcasecmp(v, "nearest") || !strcasecmp(v, "point"))
+        return ScaleFilter::Nearest;
+    if (!strcasecmp(v, "sharp-bilinear") || !strcasecmp(v, "sharp_bilinear") || !strcasecmp(v, "sharp"))
+        return ScaleFilter::SharpBilinear;
+    return ScaleFilter::Bilinear;
+}
+
+inline bool ParseFlag(const char *v) { return v && *v && std::strcmp(v, "0") != 0; }
+
+// Initial window size multiplier; <=0 or garbage -> 1 (clamped to 8).
+inline int ParseWindowScale(const char *v)
+{
+    const int n = v ? std::atoi(v) : 1;
+    return n < 1 ? 1 : (n > 8 ? 8 : n);
+}
+} // namespace ps2x
diff --git a/ps2xTest/src/display_options_tests.cpp b/ps2xTest/src/display_options_tests.cpp
new file mode 100644
index 0000000..1c516a0
--- /dev/null
+++ b/ps2xTest/src/display_options_tests.cpp
@@ -0,0 +1,25 @@
+#include "MiniTest.h"
+#include "runtime/display_options.h"
+
+// GOW-Port: parsing of the display env values.
+void register_display_options_tests()
+{
+    MiniTest::Case("DisplayOptions", [](TestCase &tc)
+    {
+        tc.Run("scale filter parsing", [](TestCase &t)
+        {
+            using ps2x::ScaleFilter;
+            t.IsTrue(ps2x::ParseScaleFilter(nullptr) == ScaleFilter::Bilinear, "default bilinear");
+            t.IsTrue(ps2x::ParseScaleFilter("bogus") == ScaleFilter::Bilinear, "unknown -> bilinear");
+            t.IsTrue(ps2x::ParseScaleFilter("Nearest") == ScaleFilter::Nearest, "nearest");
+            t.IsTrue(ps2x::ParseScaleFilter("sharp-bilinear") == ScaleFilter::SharpBilinear, "sharp-bilinear");
+        });
+        tc.Run("flag and window scale parsing", [](TestCase &t)
+        {
+            t.IsTrue(!ps2x::ParseFlag(nullptr) && !ps2x::ParseFlag("0") && !ps2x::ParseFlag(""), "off");
+            t.IsTrue(ps2x::ParseFlag("1"), "on");
+            t.IsTrue(ps2x::ParseWindowScale(nullptr) == 1 && ps2x::ParseWindowScale("x") == 1, "default 1");
+            t.IsTrue(ps2x::ParseWindowScale("2") == 2 && ps2x::ParseWindowScale("99") == 8, "clamped");
+        });
+    });
+}
