+bool GSVulkanBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba) { GOW_VK_CPU(ClearFramebuffer(context, rgba)); }
+uint32_t GSVulkanBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) { GOW_VK_CPU(ConsumeLocalToHostBytes(dst, maxBytes)); }
