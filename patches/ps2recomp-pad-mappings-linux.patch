diff --git a/ps2xRuntime/include/runtime/ps2_pad_mappings.h b/ps2xRuntime/include/runtime/ps2_pad_mappings.h
new file mode 100644
index 0000000..6201cd9
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_pad_mappings.h
@@ -0,0 +1,39 @@
+#ifndef PS2_PAD_MAPPINGS_H
+#define PS2_PAD_MAPPINGS_H
+
+#include <sstream>
+#include <string>
+
+// GOW-Port: GLFW (inside raylib) only reports buttons and sticks for pads that have an SDL-style mapping
+// (glfwJoystickIsGamepad). An unmapped pad (GameSir dongle, DualShock, 8BitDo, generic) is "present" but reads as
+// all zeros, so mappings from an SDL_GameControllerDB file are loaded at startup. Pure logic, no window needed.
+
+// Keeps only the "platform:Linux" mapping lines of a gamecontrollerdb text (drops comments and other platforms).
+inline std::string ps2PadLinuxMappings(const std::string &text)
+{
+    std::istringstream in(text);
+    std::string line, out;
+    while (std::getline(in, line))
+    {
+        if (!line.empty() && line.back() == '\r')
+            line.pop_back();
+        if (line.empty() || line[0] == '#' || line.find("platform:Linux") == std::string::npos)
+            continue;
+        out += line;
+        out += '\n';
+    }
+    return out;
+}
+
+// Fallback for a pad nobody mapped: an Xbox-like evdev layout. Returns "" for an empty guid.
+inline std::string ps2PadGenericMapping(const std::string &guid, const std::string &name)
+{
+    if (guid.empty())
+        return "";
+    return guid + "," + (name.empty() ? "Generic pad" : name) +
+           ",a:b0,b:b1,x:b2,y:b3,leftshoulder:b4,rightshoulder:b5,back:b6,start:b7,guide:b8,"
+           "leftstick:b9,rightstick:b10,leftx:a0,lefty:a1,rightx:a3,righty:a4,lefttrigger:a2,"
+           "righttrigger:a5,dpup:h0.1,dpright:h0.2,dpdown:h0.4,dpleft:h0.8,platform:Linux,\n";
+}
+
+#endif
