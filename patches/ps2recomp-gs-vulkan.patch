diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index 0b06f85..a3c2937 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -519,6 +519,34 @@ if(WIN32)
     # GOW-Port: WGL propio del hilo GS.
     target_link_libraries(ps2_runtime PRIVATE opengl32 gdi32)
 endif()
+
+# GOW-Port: Vulkan GS backend (docs/VULKAN.md). On by default on Linux; needs Vulkan and glslangValidator.
+if(UNIX AND NOT APPLE AND NOT PS2X_IS_ANDROID)
+    set(PS2X_GS_VULKAN_DEFAULT ON)
+else()
+    set(PS2X_GS_VULKAN_DEFAULT OFF)
+endif()
+option(PS2X_GS_VULKAN "Build the Vulkan GS backend" ${PS2X_GS_VULKAN_DEFAULT})
+if(PS2X_GS_VULKAN)
+    find_package(Vulkan COMPONENTS glslangValidator)
+    if(Vulkan_FOUND AND Vulkan_GLSLANG_VALIDATOR_EXECUTABLE)
+        add_executable(gs_vulkan_shader_export src/lib/gs/gpu/gs_vulkan_shader_export.cpp src/lib/gs/gpu/gs_gpu_shaders.cpp)
+        set(PS2X_VK_GEN "${CMAKE_CURRENT_BINARY_DIR}/gs_vulkan")
+        add_custom_command(OUTPUT "${PS2X_VK_GEN}/gs_vulkan_raster_spv.h"
+            COMMAND ${CMAKE_COMMAND} -E make_directory "${PS2X_VK_GEN}"
+            COMMAND gs_vulkan_shader_export "${PS2X_VK_GEN}/gs_vulkan_raster.comp"
+            COMMAND ${Vulkan_GLSLANG_VALIDATOR_EXECUTABLE} -V --target-env vulkan1.1 -S comp --vn kGsVulkanRasterSpv
+                    -o "${PS2X_VK_GEN}/gs_vulkan_raster_spv.h" "${PS2X_VK_GEN}/gs_vulkan_raster.comp"
+            DEPENDS gs_vulkan_shader_export
+            VERBATIM)
+        target_sources(ps2_runtime PRIVATE src/lib/gs/gpu/gs_vulkan_backend.cpp "${PS2X_VK_GEN}/gs_vulkan_raster_spv.h")
+        target_include_directories(ps2_runtime PRIVATE "${PS2X_VK_GEN}")
+        target_compile_definitions(ps2_runtime PUBLIC PS2X_GS_VULKAN=1)
+        target_link_libraries(ps2_runtime PUBLIC Vulkan::Vulkan)
+    else()
+        message(STATUS "Vulkan GS backend disabled: Vulkan or glslangValidator not found")
+    endif()
+endif()
 target_link_libraries(ps2EntryRunner
     PRIVATE
     ps2_runtime
