+    // Textured scene: the noisy VRAM at block 64 is the texture, CLUT data and all.
+    struct Op
+    {
+        GSPrimitiveBatch b;
+        bool clut = false; // LoadClut(b.tex0, b.texclut) instead of Submit
+    };
+
+    GSPrimitiveBatch textured(GSPrimType type, uint8_t tpsm, bool fst, bool linear, uint8_t tfx, uint64_t clamp)
+    {
+        auto b = prim(type, GS_PSM_CT32, true);
+        b.state.prim.tme = true;
+        b.state.prim.fst = fst;
+        b.state.linearFilter = linear;
+        b.state.textureWidth = 256;
+        b.state.textureHeight = 128;
+        auto &tex = b.state.context.tex0;
+        tex.tbp0 = 64; // pages 2..18, clear of every frame
+        tex.tbw = 4;
+        tex.psm = tpsm;
+        tex.tw = 8;
+        tex.th = 7;
+        tex.tcc = 1;
+        tex.tfx = tfx;
+        tex.cbp = 12000;
+        b.state.context.clamp = clamp;
+        b.state.texa = {0x40, true, 0xC0};
+        return b;
+    }
+
+    void uv(GSPrimitiveBatch &b, int i, float u, float v, float q, int texW = 256, int texH = 128)
+    {
+        auto &vx = b.vertices[i];
+        vx.u = uint16_t(u * 16.0f);
+        vx.v = uint16_t(v * 16.0f);
+        vx.s = u / texW * q;
+        vx.t = v / texH * q;
+        vx.q = q;
+    }
+
+    Op clutLoad(uint8_t tpsm, uint8_t cpsm, uint8_t csm, uint8_t csa, uint8_t cld, uint32_t cbp = 12000)
+    {
+        Op op;
+        op.clut = true;
+        auto &tex = op.b.state.context.tex0;
+        tex.psm = tpsm;
+        tex.cpsm = cpsm;
+        tex.csm = csm;
+        tex.csa = csa;
+        tex.cld = cld;
+        tex.cbp = cbp;
+        op.b.state.texclut = {2, 1, 3};
+        return op;
+    }
+
+    // CLAMP: WMS | WMT << 2 | MINU << 4 | MAXU << 14 | MINV << 24 | MAXV << 34
+    constexpr uint64_t clampReg(uint64_t wms, uint64_t wmt, uint64_t minu, uint64_t maxu, uint64_t minv, uint64_t maxv)
+    {
+        return wms | (wmt << 2) | (minu << 4) | (maxu << 14) | (minv << 24) | (maxv << 34);
+    }
+
+    std::vector<Op> texturedScene()
+    {
+        std::vector<Op> out;
+        auto add = [&](const GSPrimitiveBatch &b) { out.push_back({b, false}); };
+        // CT32, FST point sprite, modulate, REPEAT past the texture edge.
+        auto a = textured(GS_PRIM_SPRITE, GS_PSM_CT32, true, false, 0, 0);
+        vertex(a, 0, 10.0f, 10.0f, 0); vertex(a, 1, 300.5f, 200.25f, 0x80907060u);
+        uv(a, 0, 13.3f, 7.7f, 1.0f); uv(a, 1, 300.0f, 190.0f, 1.0f);
+        add(a);
+        // CT24 STQ bilinear sprite, decal, CLAMP, TEXA AEM.
+        auto b = textured(GS_PRIM_SPRITE, GS_PSM_CT24, false, true, 1, clampReg(1, 1, 0, 0, 0, 0));
+        vertex(b, 0, 320.0f, 10.0f, 0); vertex(b, 1, 630.0f, 230.0f, 0x40404040u);
+        uv(b, 0, -20.0f, 3.5f, 1.0f); uv(b, 1, 270.0f, 140.0f, 1.0f);
+        add(b);
+        // CT16 perspective triangle, Gouraud, highlight, region clamp.
+        auto c = textured(GS_PRIM_TRIANGLE, GS_PSM_CT16, false, false, 2, clampReg(2, 2, 10, 200, 5, 100));
+        vertex(c, 0, 20.0f, 220.0f, 0x10FF8020u); vertex(c, 1, 600.0f, 250.0f, 0x8000FF80u); vertex(c, 2, 200.0f, 440.0f, 0xFF4080FFu);
+        uv(c, 0, 0.0f, 0.0f, 1.0f); uv(c, 1, 250.0f, 20.0f, 2.5f); uv(c, 2, 60.0f, 127.0f, 0.7f);
+        add(c);
+        // CT16S FST bilinear triangle, highlight2, region repeat; 16-bit frame.
+        auto d = textured(GS_PRIM_TRIANGLE, GS_PSM_CT16S, true, true, 3, clampReg(3, 3, 0x3F, 0x40, 0x1F, 0x20));
+        d.state.context.frame = {300, 10, GS_PSM_CT16, 0};
+        vertex(d, 0, 5.0f, 5.0f, 0x80808080u); vertex(d, 1, 630.0f, 60.0f, 0x20406080u); vertex(d, 2, 320.0f, 400.0f, 0xF0E0D0C0u);
+        uv(d, 0, 1.25f, 2.5f, 1.0f); uv(d, 1, 500.0f, 10.0f, 1.0f); uv(d, 2, 100.0f, 300.0f, 1.0f);
+        add(d);
+        // T8 with a CT32 CLUT (CSM1 swizzle), TCC=0.
+        out.push_back(clutLoad(GS_PSM_T8, GS_PSM_CT32, 0, 0, 1));
+        auto e = textured(GS_PRIM_SPRITE, GS_PSM_T8, true, true, 0, 0);
+        e.state.context.tex0.cpsm = GS_PSM_CT32;
+        e.state.context.tex0.tcc = 0;
+        e.state.context.test = 0x1u | (2u << 1) | (0x50u << 4) | (1u << 12); // LESS 0x50, AFAIL=FB_ONLY
+        vertex(e, 0, 40.0f, 240.0f, 0); vertex(e, 1, 280.0f, 440.0f, 0x7F7F7F7Fu);
+        uv(e, 0, 0.0f, 0.0f, 1.0f); uv(e, 1, 256.0f, 128.0f, 1.0f);
+        add(e);
+        // CLD=0 keeps the GPU run going; T4 with a CT16 CLUT at CSA 3.
+        out.push_back(clutLoad(GS_PSM_T4, GS_PSM_CT16, 0, 3, 0));
+        out.push_back(clutLoad(GS_PSM_T4, GS_PSM_CT16, 0, 3, 1, 12100));
+        auto f = textured(GS_PRIM_TRIANGLE, GS_PSM_T4, false, true, 0, clampReg(0, 1, 0, 0, 0, 0));
+        f.state.context.tex0.cpsm = GS_PSM_CT16;
+        f.state.context.tex0.csa = 3;
+        vertex(f, 0, 300.0f, 250.0f, 0x80808080u); vertex(f, 1, 630.0f, 300.0f, 0x80FF8080u); vertex(f, 2, 400.0f, 440.0f, 0x808080FFu);
+        uv(f, 0, 3.0f, 3.0f, 1.2f); uv(f, 1, 200.0f, 40.0f, 0.9f); uv(f, 2, 90.0f, 140.0f, 3.0f);
+        add(f);
+        // CSM2-style CLUT (csm=1, TEXCLUT offsets) for T8H, then T4HH and T4HL.
+        out.push_back(clutLoad(GS_PSM_T8H, GS_PSM_CT32, 1, 0, 1, 12200));
+        auto g = textured(GS_PRIM_SPRITE, GS_PSM_T8H, false, false, 0, 0);
+        g.state.context.tex0.cpsm = GS_PSM_CT32;
+        g.state.context.tex0.csm = 1;
+        vertex(g, 0, 300.0f, 300.0f, 0); vertex(g, 1, 400.0f, 400.0f, 0x80808080u);
+        uv(g, 0, 10.0f, 10.0f, 1.0f); uv(g, 1, 90.0f, 70.0f, 1.0f);
+        add(g);
+        out.push_back(clutLoad(GS_PSM_T4HH, GS_PSM_CT32, 0, 2, 1, 12300));
+        for (uint8_t psm : {GS_PSM_T4HH, GS_PSM_T4HL})
+        {
+            auto h = textured(GS_PRIM_SPRITE, psm, true, false, 1, 0);
+            h.state.context.tex0.cpsm = GS_PSM_CT32;
+            h.state.context.tex0.csa = 2;
+            const float x = psm == GS_PSM_T4HH ? 420.0f : 520.0f;
+            vertex(h, 0, x, 300.0f, 0); vertex(h, 1, x + 90.0f, 440.0f, 0x80808080u);
+            uv(h, 0, 0.0f, 0.0f, 1.0f); uv(h, 1, 64.0f, 100.0f, 1.0f);
+            add(h);
+        }
+        // Blending over textures: (Cs - Cd) * As + Cd without COLCLAMP (wraps) on a CT24 frame (Ad = 0x80)...
+        auto m = textured(GS_PRIM_TRIANGLE, GS_PSM_CT32, true, true, 2, 0);
+        m.state.prim.abe = true;
+        m.state.context.alpha = 0x44u; // A=Cs B=Cd C=As D=Cd
+        m.state.context.frame = {250, 10, GS_PSM_CT24, 0}; // fbp 400 would wrap onto the texture pages
+        vertex(m, 0, 0.0f, 0.0f, 0x80FF00FFu); vertex(m, 1, 630.0f, 20.0f, 0xFF808080u); vertex(m, 2, 50.0f, 440.0f, 0x2000FF00u);
+        uv(m, 0, 0.0f, 0.0f, 1.0f); uv(m, 1, 255.0f, 0.0f, 1.0f); uv(m, 2, 0.0f, 127.0f, 1.0f);
+        add(m);
+        // ...and (Cd - Cs) * Ad + 0 with PABE and COLCLAMP on a CT16 frame.
+        auto n = textured(GS_PRIM_SPRITE, GS_PSM_CT16, false, false, 0, 0);
+        n.state.prim.abe = true;
+        n.state.pabe = true;
+        n.state.colclamp = 1;
+        n.state.context.test = 0x1u | (7u << 1) | (0x80u << 4); // NOTEQUAL 0x80, AFAIL=KEEP
+        n.state.context.alpha = 0x01u | (0u << 2) | (1u << 4) | (2u << 6);
+        n.state.context.frame = {300, 10, GS_PSM_CT16, 0};
+        vertex(n, 0, 100.0f, 100.0f, 0); vertex(n, 1, 600.0f, 400.0f, 0xFF808080u);
+        uv(n, 0, 0.0f, 0.0f, 1.0f); uv(n, 1, 256.0f, 128.0f, 1.0f);
+        add(n);
+        return out;
+    }
+
+    std::vector<uint8_t> noise()
+    {
+        std::vector<uint8_t> vram(4u << 20);
+        uint32_t seed = 777u;
+        for (auto &b : vram) { seed = seed * 1664525u + 1013904223u; b = uint8_t(seed >> 24); }
+        return vram;
+    }
+
+
+    // GOW-Port: feedback (the frame sampling itself), Z-as-colour, Z in the frame's memory and destination alpha test.
+    GSPrimitiveBatch frameTex(GSPrimType type, bool linear, uint8_t tfx = 1)
+    {
+        auto b = textured(type, GS_PSM_CT32, true, linear, tfx, 0);
+        b.state.context.tex0.tbp0 = 100 * 32; // the frame buffer itself (fbp 100)
+        b.state.context.tex0.tbw = 10;
+        b.state.textureWidth = 1024;
+        b.state.textureHeight = 512;
+        return b;
+    }
+
+    std::vector<GSPrimitiveBatch> feedbackScene()
+    {
+        std::vector<GSPrimitiveBatch> out;
+        auto sprite = [&](float x0, float y0, float x1, float y1, float du, float dv, bool linear, uint8_t tfx = 1) {
+            auto b = frameTex(GS_PRIM_SPRITE, linear, tfx);
+            vertex(b, 0, x0, y0, 0x80808080u); vertex(b, 1, x1, y1, 0x80808080u);
+            uv(b, 0, x0 + du, y0 + dv, 1.0f); uv(b, 1, x1 + du, y1 + dv, 1.0f);
+            out.push_back(b);
+        };
+        sprite(64, 32, 160, 96, 0.5f, 0.5f, false);                  // each pixel samples itself (nearest)
+        sprite(200, 32, 300, 96, 0.5f, 0.5f, true);                  // ...and bilinear at the texel centre
+        auto t = frameTex(GS_PRIM_TRIANGLE, false);                   // triangle, u = x + 0.5
+        vertex(t, 0, 64, 120, 0x80808080u); vertex(t, 1, 250, 120, 0x80808080u); vertex(t, 2, 64, 200, 0x80808080u);
+        uv(t, 0, 64.5f, 120.5f, 1.0f); uv(t, 1, 250.5f, 120.5f, 1.0f); uv(t, 2, 64.5f, 200.5f, 1.0f);
+        out.push_back(t);
+        for (int k = 0; k < 4; ++k)                                   // 8-px strips reading the columns 8 px to the left
+            sprite(float(300 + 16 * k), 20, float(308 + 16 * k), 100, -8.0f + 0.5f, 0.5f, false);
+        sprite(100, 50, 180, 80, 0.5f, 0.5f, false, 0);               // modulate, over the first sprite
+        sprite(400, 150, 480, 220, 10.5f, 0.5f, false);               // reads 10 px to the right inside itself: CPU
+        auto za = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false);           // Z buffer in the frame's own memory: Z32 and CT32 swizzle differently, so this stays on the CPU
+        za.state.context.frame = {200, 10, GS_PSM_CT32, 0};
+        za.state.context.zbuf = {200, GS_PSM_Z32, false};
+        za.state.context.test = 0x10000u | (2u << 17);
+        vertex(za, 0, 10, 300, 0); vertex(za, 1, 200, 380, 0xFF30A0C0u);
+        za.vertices[1].z = 0x7FFFFFFF;
+        out.push_back(za);
+        za.vertices[1].z = 0x80000000u; // second one over it
+        vertex(za, 0, 60, 330, 0); vertex(za, 1, 260, 420, 0x40C03010u);
+        out.push_back(za);
+        // Frame and Z share pages but no word is shared by two different pixels (Z32/Z24 block table differs from CT32/CT24):
+        // one 8x8 block, a 64x16 strip (two block rows) and the CT24/Z24 variant stay on the GPU.
+        auto zs = [&](uint32_t fbp, uint32_t psm, uint32_t zpsm, float x0, float y0, float x1, float y1, uint32_t color, bool write) {
+            auto b = prim(GS_PRIM_SPRITE, psm, false);
+            b.state.context.frame = {fbp, 10, psm, 0};
+            b.state.context.zbuf = {fbp, zpsm, !write};
+            b.state.context.test = 0x10000u | (2u << 17);
+            vertex(b, 0, x0, y0, 0); vertex(b, 1, x1, y1, color);
+            b.vertices[1].z = 0x7FFFFFFF;
+            out.push_back(b);
+        };
+        zs(250, GS_PSM_CT32, GS_PSM_Z32, 8, 8, 16, 16, 0xFF30A0C0u, true);
+        zs(250, GS_PSM_CT32, GS_PSM_Z32, 0, 0, 64, 16, 0x80C03010u, true);
+        zs(260, GS_PSM_CT24, GS_PSM_Z24, 0, 0, 32, 8, 0xFF1080F0u, true);
+        zs(270, GS_PSM_CT32, GS_PSM_Z32, 0, 16, 64, 32, 0xFF204080u, false); // Z only tested
+        auto zc = frameTex(GS_PRIM_SPRITE, false);                    // Z pages read as colour, Z only tested
+        zc.state.context.frame = {300, 10, GS_PSM_CT32, 0};
+        zc.state.context.tex0.tbp0 = 480 * 32;
+        zc.state.context.zbuf = {480, GS_PSM_Z32, true};
+        zc.state.context.test = 0x10000u | (2u << 17);
+        vertex(zc, 0, 20, 20, 0x80808080u); vertex(zc, 1, 120, 90, 0x80808080u);
+        uv(zc, 0, 20.5f, 20.5f, 1.0f); uv(zc, 1, 120.5f, 90.5f, 1.0f);
+        zc.vertices[1].z = 0x100;
+        out.push_back(zc);
+        auto d0 = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false);           // destination alpha test, DATM 0 and 1
+        d0.state.context.test = 0x4000u;
+        vertex(d0, 0, 400, 300, 0); vertex(d0, 1, 560, 400, 0x80FF8040u);
+        out.push_back(d0);
+        auto d1 = prim(GS_PRIM_SPRITE, GS_PSM_CT16, false);
+        d1.state.context.frame = {400, 10, GS_PSM_CT16, 0};
+        d1.state.context.test = 0x4000u | 0x8000u;
+        vertex(d1, 0, 10, 10, 0); vertex(d1, 1, 400, 300, 0x80FF8040u);
+        out.push_back(d1);
+        return out;
+    }
+
+    std::vector<uint8_t> renderFeedback(GSRasterBackend &backend)
+    {
+        auto vram = noise();
+        backend.Initialize(vram.data(), uint32_t(vram.size()));
+        for (const auto &b : feedbackScene())
+            backend.Submit(b);
+        backend.Flush();
+        return vram;
+    }
+
+    template <typename Backend>
+    std::vector<uint8_t> render(Backend &backend)
+    {
+        auto vram = noise();
+        backend.Initialize(vram.data(), uint32_t(vram.size()));
+        for (const auto &b : scene())
+            backend.Submit(b);
+        backend.Flush();
+        return vram;
+    }
+
+    // Page-aligned VRAM: the Vulkan backend imports it as the GPU buffer (zero-copy) instead of copying.
+    std::vector<uint8_t> renderAligned(GSRasterBackend &backend)
+    {
+        const auto init = noise();
+        void *mem = std::aligned_alloc(4096, init.size());
+        std::memcpy(mem, init.data(), init.size());
+        backend.Initialize(static_cast<uint8_t *>(mem), uint32_t(init.size()));
+        for (const auto &b : scene())
+            backend.Submit(b);
+        backend.Flush();
+        std::vector<uint8_t> out(static_cast<uint8_t *>(mem), static_cast<uint8_t *>(mem) + init.size());
+        backend.Initialize(nullptr, 0); // release the import before freeing
+        std::free(mem);
+        return out;
+    }
+
+    std::vector<uint8_t> renderTextured(GSRasterBackend &backend)
+    {
+        auto vram = noise();
+        backend.Initialize(vram.data(), uint32_t(vram.size()));
+        for (const auto &op : texturedScene())
+        {
+            if (op.clut)
+                backend.LoadClut(op.b.state.context.tex0, op.b.state.texclut);
+            else
+                backend.Submit(op.b);
+        }
+        backend.Flush();
+        return vram;
+    }
+}
+#endif
+
+void register_gs_vulkan_tests()
+{
+    MiniTest::Case("GS Vulkan backend", [](TestCase &test) {
+        test.Run("Vulkan VRAM equals CPU VRAM", [](TestCase &t) {
+#if defined(PS2X_GS_VULKAN)
+            GSVulkanBackend vulkan;
+            if (!vulkan.IsReady())
+            {
+                std::printf("    [skip] no Vulkan device\n");
+                return;
+            }
+            GSCpuBackend cpu;
+            const auto reference = render(cpu);
+            const auto gpu = render(vulkan);
+            size_t diff = 0;
+            for (size_t i = 0; i < reference.size(); ++i)
+                diff += reference[i] != gpu[i];
+            t.Equals(diff, size_t(0), "Differing VRAM bytes between Vulkan and CPU");
+            t.Equals(vulkan.GpuPrimitives(), uint64_t(12), "Primitives drawn on the GPU");
+            GSVulkanBackend imported;
+            t.IsTrue(renderAligned(imported) == reference, "Host-imported VRAM equals the CPU reference");
+            t.IsTrue(reference != noise(), "The scene changed VRAM");
+#else
+            std::printf("    [skip] built without PS2X_GS_VULKAN\n");
+            t.IsTrue(true, "skipped");
+#endif
+        });
+        // GOW-Port: PS2X_VK_DEVICE that matches no device must fall back to the default choice, not disable the backend.
+        test.Run("Unmatched PS2X_VK_DEVICE falls back to the default device", [](TestCase &t) {
+#if defined(PS2X_GS_VULKAN)
+            GSVulkanBackend reference;
+            if (!reference.IsReady())
+            {
+                std::printf("    [skip] no Vulkan device\n");
+                return;
+            }
+#ifdef _WIN32
+            _putenv_s("PS2X_VK_DEVICE", "no-such-gpu-zzz");
+#else
+            setenv("PS2X_VK_DEVICE", "no-such-gpu-zzz", 1);
+#endif
+            GSVulkanBackend fallback;
+#ifdef _WIN32
+            _putenv_s("PS2X_VK_DEVICE", "");
+#else
+            unsetenv("PS2X_VK_DEVICE");
+#endif
+            t.IsTrue(fallback.IsReady(), "Backend is ready with an unmatched device name");
+#else
+            std::printf("    [skip] built without PS2X_GS_VULKAN\n");
+            t.IsTrue(true, "skipped");
+#endif
+        });
+        test.Run("Textured Vulkan VRAM equals CPU VRAM", [](TestCase &t) {
+#if defined(PS2X_GS_VULKAN)
+            GSVulkanBackend vulkan;
+            if (!vulkan.IsReady())
+            {
+                std::printf("    [skip] no Vulkan device\n");
+                return;
+            }
+            GSCpuBackend cpu;
+            const auto reference = renderTextured(cpu);
+            const auto gpu = renderTextured(vulkan);
+            size_t diff = 0, first = reference.size();
+            for (size_t i = 0; i < reference.size(); ++i)
+                if (reference[i] != gpu[i])
+                {
+                    first = std::min(first, i);
+                    ++diff;
+                }
+            if (diff)
+                std::printf("    first differing byte at 0x%zx\n", first);
+            t.Equals(diff, size_t(0), "Differing VRAM bytes between Vulkan and CPU");
+            t.Equals(vulkan.GpuPrimitives(), uint64_t(11), "Textured primitives drawn on the GPU");
+#else
+            std::printf("    [skip] built without PS2X_GS_VULKAN\n");
+            t.IsTrue(true, "skipped");
+#endif
+        });
+        // GOW-Port: textured feedback, Z-as-colour, Z aliasing the frame and DATE draw on the GPU and match the CPU.
+        test.Run("Feedback and Z-as-colour Vulkan VRAM equals CPU VRAM", [](TestCase &t) {
+#if defined(PS2X_GS_VULKAN)
+            GSVulkanBackend vulkan;
+            if (!vulkan.IsReady())
+            {
+                std::printf("    [skip] no Vulkan device\n");
+                return;
+            }
+            GSCpuBackend cpu;
+            const auto reference = renderFeedback(cpu);
+            const auto gpu = renderFeedback(vulkan);
+            size_t diff = 0, first = reference.size();
+            for (size_t i = 0; i < reference.size(); ++i)
+                if (reference[i] != gpu[i])
+                {
+                    first = std::min(first, i);
+                    ++diff;
+                }
+            if (diff)
+                std::printf("    first differing byte at 0x%zx\n", first);
+            t.Equals(diff, size_t(0), "Differing VRAM bytes between Vulkan and CPU");
+            t.Equals(vulkan.GpuPrimitives(), uint64_t(15), "Primitives drawn on the GPU (real feedback and Z aliasing that shares words stay on the CPU)");
+            t.IsTrue(reference != noise(), "The scene changed VRAM");
+#else
+            std::printf("    [skip] built without PS2X_GS_VULKAN\n");
+            t.IsTrue(true, "skipped");
+#endif
+        });
+    });
+}
