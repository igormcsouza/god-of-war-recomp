+// GOW-Port: scan gamepads on every read so hotplug works; GOW_PAD_INDEX forces one index.
+int ps2PadActiveGamepad()
+{
+    constexpr int kMaxPads = 4;
+    static const int forced = []
+    {
+        const char *v = std::getenv("GOW_PAD_INDEX");
+        return (v && *v) ? std::atoi(v) : -1;
+    }();
+    static std::atomic<int> current{-1};
+    bool avail[kMaxPads];
+    for (int i = 0; i < kMaxPads; ++i)
+        avail[i] = IsGamepadAvailable(i);
+    const int pick = ps2SelectGamepad(avail, kMaxPads, forced, current.load());
+    current.store(pick);
+    return pick;
+}
