+struct Input
+{
+    Header h;
+    VU1State state;
+    std::vector<uint8_t> code, data;
+};
+
+// Como en el juego: un intérprete que persiste y una micromemoria que solo se reescribe cuando cambia el programa.
+void benchOne(PS2Memory &mem, GS &gs, VU1Interpreter &vu, const Input &in, const std::vector<uint8_t> *&loaded)
+{
+    if (loaded == nullptr || *loaded != in.code)
+    {
+        std::memcpy(mem.getVU1Code(), in.code.data(), in.code.size());
+        uint32_t first;
+        std::memcpy(&first, in.code.data(), sizeof(first));
+        mem.write32(0x11008000u, first);
+        loaded = &in.code;
+    }
+    std::memcpy(mem.getVU1Data(), in.data.data(), in.data.size());
+    vu.state() = in.state;
+    vu.execute(mem.getVU1Code(), PS2_VU1_CODE_SIZE, mem.getVU1Data(), PS2_VU1_DATA_SIZE, gs, &mem, in.h.startPc, in.h.top,
+               in.h.itop, in.h.maxCycles);
+}
