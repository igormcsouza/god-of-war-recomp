+++ b/ps2xRuntime/include/runtime/ps2_pipe_stats.h
@@ -0,0 +1,70 @@
+#pragma once
+// GOW-Port: contadores opt-in (PS2X_PIPE_STATS=1) de espera por etapa del pipeline EE->VU1->GIF->GS.
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+namespace ps2_pipe
+{
+enum Slot : int
+{
+    VsyncLock, SyncVu1, SyncFront, PublishWait, GsIdle, GsBusy, DrainWait, GuestWait,
+    Vu1Idle, Vu1Busy, FrontIdle, FrontBusy, SlotCount
+};
+inline const char *const kNames[SlotCount] = {"ee_vsync_lock", "ee_sync_vu1", "ee_sync_front", "publish_wait", "gs_idle",
+                                              "gs_busy", "drain_wait", "guest_wait", "vu1_idle", "vu1_busy",
+                                              "front_idle", "front_busy"};
+inline bool enabled()
+{
+    static const bool on = [] { const char *v = std::getenv("PS2X_PIPE_STATS"); return v && *v && *v != '0'; }();
+    return on;
+}
+inline std::atomic<uint64_t> g_ns[SlotCount];
+inline std::atomic<uint64_t> g_n[SlotCount];
+inline std::atomic<uint64_t> g_qHigh{0};
+inline std::atomic<uint64_t> g_frontHigh{0};
+inline void raise(std::atomic<uint64_t> &a, uint64_t v)
+{
+    uint64_t c = a.load(std::memory_order_relaxed);
+    while (v > c && !a.compare_exchange_weak(c, v, std::memory_order_relaxed)) {}
+}
+inline void startPrinter()
+{
+    static std::atomic<bool> started{false};
+    if (!enabled() || started.exchange(true))
+        return;
+    std::thread([] {
+        uint64_t prevNs[SlotCount] = {}, prevN[SlotCount] = {};
+        for (;;)
+        {
+            std::this_thread::sleep_for(std::chrono::seconds(1));
+            std::fprintf(stderr, "[pipe]");
+            for (int i = 0; i < SlotCount; ++i)
+            {
+                const uint64_t ns = g_ns[i].load(), n = g_n[i].load();
+                std::fprintf(stderr, " %s=%.0fms/%llu", kNames[i], double(ns - prevNs[i]) / 1e6, (unsigned long long)(n - prevN[i]));
+                prevNs[i] = ns; prevN[i] = n;
+            }
+            std::fprintf(stderr, " qhigh=%llu fronthigh=%llu\n", (unsigned long long)g_qHigh.exchange(0), (unsigned long long)g_frontHigh.exchange(0));
+        }
+    }).detach();
+}
+struct Scope
+{
+    Slot slot;
+    std::chrono::steady_clock::time_point t0;
+    explicit Scope(Slot s) : slot(s)
+    {
+        if (enabled()) { startPrinter(); t0 = std::chrono::steady_clock::now(); }
+    }
+    ~Scope()
+    {
+        if (!enabled()) return;
+        g_ns[slot].fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()), std::memory_order_relaxed);
+        g_n[slot].fetch_add(1, std::memory_order_relaxed);
+    }
+};
+} // namespace ps2_pipe
