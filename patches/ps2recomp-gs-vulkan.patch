+    GSPrimitiveBatch prim(GSPrimType type, uint8_t psm, bool iip)
+    {
+        GSPrimitiveBatch b{};
+        b.vertexCount = type == GS_PRIM_SPRITE ? 2 : 3;
+        b.state.prim.type = type;
+        b.state.prim.iip = iip;
+        auto &c = b.state.context;
+        c.frame = {100, 10, psm, 0};
+        c.scissor = {0, 639, 0, 447};
+        c.zbuf = {480, GS_PSM_Z32, true};
+        return b;
+    }
+
+    void vertex(GSPrimitiveBatch &b, int i, float x, float y, uint32_t rgba)
+    {
+        auto &v = b.vertices[i];
+        v.x = x;
+        v.y = y;
+        v.r = uint8_t(rgba);
+        v.g = uint8_t(rgba >> 8);
+        v.b = uint8_t(rgba >> 16);
+        v.a = uint8_t(rgba >> 24);
+    }
+
+    std::vector<GSPrimitiveBatch> scene()
+    {
+        std::vector<GSPrimitiveBatch> out;
+        auto s = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false); // flat sprite, fractional edges
+        vertex(s, 0, 20.5f, 10.25f, 0); vertex(s, 1, 520.5f, 300.75f, 0x80C02010u);
+        out.push_back(s);
+        auto g = prim(GS_PRIM_TRIANGLE, GS_PSM_CT32, true); // Gouraud triangle
+        vertex(g, 0, 30.0f, 40.0f, 0x10FF0000u); vertex(g, 1, 600.3f, 90.6f, 0x8000FF00u); vertex(g, 2, 100.7f, 420.1f, 0xFF0000FFu);
+        out.push_back(g);
+        auto f = prim(GS_PRIM_TRISTRIP, GS_PSM_CT32, false); // flat, uses v2, scissor + XYOFFSET
+        f.state.context.scissor = {64, 300, 50, 200};
+        f.state.context.xyoffset = {16 * 8, 16 * 4};
+        vertex(f, 0, 400.0f, 10.0f, 1); vertex(f, 1, 20.0f, 300.0f, 2); vertex(f, 2, 350.0f, 260.0f, 0x7F334455u);
+        out.push_back(f);
+        auto m = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false); // FBMSK + FBA
+        m.state.context.frame.fbmsk = 0xFF00FF00u;
+        m.state.context.fba = 1;
+        vertex(m, 0, 100.0f, 100.0f, 0); vertex(m, 1, 200.0f, 180.0f, 0x11223344u);
+        out.push_back(m);
+        auto a = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false); // Z test GEQUAL against noise, Z write
+        a.state.context.test = 0x10000u | (2u << 17);
+        a.state.context.zbuf.zmask = false;
+        vertex(a, 0, 150.0f, 50.0f, 0); vertex(a, 1, 450.0f, 350.0f, 0x40FFFFFFu);
+        a.vertices[1].z = 0x80001234;
+        out.push_back(a);
+        auto ln = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false); // line: CPU fallback between GPU draws
+        ln.state.prim.type = GS_PRIM_LINE;
+        vertex(ln, 0, 10.0f, 20.0f, 0); vertex(ln, 1, 600.0f, 400.0f, 0xFF00FF00u);
+        out.push_back(ln);
+        auto zv = prim(GS_PRIM_TRIANGLE, GS_PSM_CT32, false); // interpolated Z, GEQUAL against the sprite Z
+        zv.state.context.test = 0x10000u | (2u << 17);
+        zv.state.context.zbuf.zmask = false;
+        vertex(zv, 0, 140.0f, 40.0f, 0); vertex(zv, 1, 460.0f, 60.0f, 0); vertex(zv, 2, 200.0f, 360.0f, 0x30405060u);
+        zv.vertices[0].z = 0x80000000u; zv.vertices[1].z = 0x80003001u; zv.vertices[2].z = 0x7FFF0000u;
+        out.push_back(zv);
+        auto zb = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false); // alpha fail ZB_ONLY: Z16 written, frame kept
+        zb.state.context.test = 0x1u | (0u << 1) | (2u << 12) | 0x10000u | (3u << 17); // NEVER; Z GREATER
+        zb.state.context.zbuf = {480, GS_PSM_Z16, false};
+        vertex(zb, 0, 30.0f, 300.0f, 0); vertex(zb, 1, 330.0f, 440.0f, 0x7F7F7F7Fu);
+        zb.vertices[1].z = 0x8000;
+        out.push_back(zb);
+        auto r = prim(GS_PRIM_TRIANGLE, GS_PSM_CT32, true); // alpha test fails partly, AFAIL=RGB_ONLY
+        r.state.context.test = 0x1u | (5u << 1) | (0x30u << 4) | (3u << 12); // GEQUAL 0x30
+        vertex(r, 0, 100.0f, 300.0f, 0x00FFFFFFu); vertex(r, 1, 600.0f, 320.0f, 0x80FFFFFFu); vertex(r, 2, 300.0f, 440.0f, 0x60102030u);
+        out.push_back(r);
+        auto l = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false); // blended (A=Cs B=0 C=FIX D=Cd) on the GPU
+        l.state.prim.abe = true;
+        l.state.context.alpha = (uint64_t(64) << 32) | 0x64u;
+        vertex(l, 0, 250.0f, 150.0f, 0); vertex(l, 1, 500.0f, 400.0f, 0x40FFFFFFu);
+        out.push_back(l);
+        auto h = prim(GS_PRIM_TRIANGLE, GS_PSM_CT16, true); // 16-bit target, other page
+        h.state.context.frame = {300, 10, GS_PSM_CT16, 0x00008000u};
+        vertex(h, 0, 5.0f, 5.0f, 0xFF102030u); vertex(h, 1, 630.0f, 30.0f, 0x00F0E0D0u); vertex(h, 2, 300.0f, 440.0f, 0x80808080u);
+        out.push_back(h);
+        auto t = prim(GS_PRIM_SPRITE, GS_PSM_CT24, false); // 24-bit keeps the top byte
+        t.state.context.frame = {400, 10, GS_PSM_CT24, 0};
+        vertex(t, 0, 0.0f, 0.0f, 0); vertex(t, 1, 333.0f, 222.0f, 0xAABBCCDDu);
+        out.push_back(t);
+        auto o = prim(GS_PRIM_SPRITE, GS_PSM_CT32, false); // overlaps the blended sprite: order matters
+        vertex(o, 0, 300.0f, 200.0f, 0); vertex(o, 1, 380.0f, 260.0f, 0x01020304u);
