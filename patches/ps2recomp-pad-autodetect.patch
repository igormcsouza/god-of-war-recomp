new file mode 100644
index 0000000..1c657ae
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_pad_select.h
@@ -0,0 +1,26 @@
+#ifndef PS2_PAD_SELECT_H
+#define PS2_PAD_SELECT_H
+
+// GOW-Port: pure gamepad selection logic (no window needed, unit-testable).
+
+// Picks which gamepad index feeds the PS2 pad.
+//   avail[i] : whether gamepad i is currently connected (i < count)
+//   forced   : GOW_PAD_INDEX override, or -1 for autodetect
+//   current  : index used on the previous frame, or -1
+// Returns the index to use, or -1 for "no gamepad" (keyboard fallback).
+// A forced index never falls back to another pad: if it is absent, use the keyboard.
+// Autodetect keeps the current pad while it stays connected (no flip-flopping when a
+// second pad is plugged in) and otherwise takes the first connected one.
+inline int ps2SelectGamepad(const bool *avail, int count, int forced, int current)
+{
+    if (forced >= 0)
+        return (forced < count && avail[forced]) ? forced : -1;
+    if (current >= 0 && current < count && avail[current])
+        return current;
+    for (int i = 0; i < count; ++i)
+        if (avail[i])
+            return i;
+    return -1;
+}
+
+#endif
